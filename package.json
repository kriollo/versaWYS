{
    "name": "versawys-php",
    "version": "2.0.0",
    "description": "versaWYS-PHP es un framework PHP versátil, simple, ligero, rápido y fácil de usar. Ofrece enrutamiento para aplicaciones web y APIs REST, VersaORM para la base de datos, Twig para plantillas y un panel de administración en Vue 3 + TypeScript.",
    "type": "module",
    "author": "Jorge Jara H.(jjara@wys.cl)",
    "license": "MIT",
    "scripts": {
        "watch": "versacompiler -w --tailwind --verbose",
        "compile": "pnpm run versaCompileCSS && pnpm run versaCompileJS",
        "compileDev": "versacompiler --all --cc --verbose --tailwind --linter -t -y",
        "compileCI": "versacompiler --all --cc -y --ci",
        "versaCompileJS": "versacompiler --all --cc --tailwind --prod -y",
        "versaCompileCSS": "tailwindcss -i ./src/dashboard/css/dashboard.css -o ./public/dashboard/css/dashboard.css --minify",
        "lint": "oxlint src/",
        "lint:fix": "oxlint src/ --fix",
        "format": "prettier --write \"src/**/*.{js,ts,vue,css,json}\"",
        "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,json}\""
    },
    "dependencies": {
        "sweetalert2": "^11.26.25",
        "vue": "^3.5.42"
    },
    "devDependencies": {
        "@prettier/plugin-php": "^0.25.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^22.20.2",
        "@vue/compiler-dom": "^3.5.42",
        "@vue/reactivity": "^3.5.42",
        "@vue/runtime-core": "^3.5.42",
        "@vue/runtime-dom": "^3.5.42",
        "@zackad/prettier-plugin-twig": "^0.17.0",
        "code-tag": "^1.2.0",
        "globals": "^17.12.0",
        "oxlint": "1.82.0",
        "prettier": "3.9.6",
        "tailwindcss": "3.4.19",
        "versacompiler": "2.7.1"
    }
}
