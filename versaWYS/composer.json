{
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "twig/twig": "3.28.0",
        "firebase/php-jwt": "7.1.0",
        "symfony/mailer": "8.1.2",
        "twig/cssinliner-extra": "3.26.0",
        "twig/extra-bundle": "3.24.0",
        "versaorm/versaorm-php": "^1.9.0"
    },
    "autoload": {
        "psr-4": {
            "versaWYS\\kernel\\": "../versaWYS/kernel/",
            "app\\": "../app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsoftwig/twigcs": "^6.6.1",
        "laravel/pint": "^1.30.5",
        "pestphp/pest": "^5.1.0",
        "phpstan/phpstan": "^2.2.8",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.6.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "pint",
        "pint:check": "pint --test",
        "rector:check": "rector process --dry-run --ansi",
        "rector:fix": "rector process --ansi",
        "stan": "phpstan analyse --ansi --memory-limit=1G",
        "test": "pest",
        "check": [
            "@pint:check",
            "@stan",
            "@test"
        ],
        "fix": [
            "@pint",
            "@rector:fix"
        ]
    }
}
