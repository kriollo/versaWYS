{
    "require": {
        "php": ">=8.3",
        "twig/twig": "^3.28",
        "versaorm/versaorm-php": "^2.0",
        "versawys/kernel": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "app\\": "../app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsoftwig/twigcs": "^6.6.1",
        "laravel/pint": "^1.30.5",
        "pestphp/pest": "^4.1 || ^5.1",
        "rector/rector": "^2.6.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "pint": "pint",
        "pint:check": "pint --test",
        "rector:check": "rector process --dry-run --ansi",
        "rector:fix": "rector process --ansi",
        "test": "pest",
        "check": [
            "@pint:check",
            "@test"
        ],
        "fix": [
            "@pint",
            "@rector:fix"
        ]
    }
}
