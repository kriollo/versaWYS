{
    "name": "versawys/versawys",
    "description": "Esqueleto de proyecto versaWYS-PHP: panel de administración en Vue 3 + TypeScript sobre el kernel versawys/kernel.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "twig/twig": "^3.30",
        "versaorm/versaorm-php": "^2.0.1",
        "versawys/kernel": "^3.4.0"
    },
    "require-dev": {
        "friendsoftwig/twigcs": "^6.6.1",
        "pestphp/pest": "^4.1 || ^5.1",
        "rector/rector": "^2.7",
        "carthage-software/mago": "^1.57"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "versaWYS/tests/"
        }
    },
    "config": {
        "vendor-dir": "versaWYS/vendor",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "carthage-software/mago": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-create-project-cmd": [
            "@php versaCLI config:init"
        ],
        "mago:fmt": "mago fmt",
        "mago:fmt:check": "mago fmt --dry-run",
        "mago:lint": "mago lint",
        "mago:lint:fix": "mago lint --fix --unsafe --format-after-fix",
        "rector:check": "rector process --config versaWYS/rector.php --dry-run --ansi",
        "rector:fix": "rector process --config versaWYS/rector.php --ansi",
        "test": "pest --configuration versaWYS/phpunit.xml",
        "check": [
            "@mago:fmt:check",
            "@test"
        ],
        "fix": [
            "@rector:fix",
            "@mago:fmt"
        ]
    }
}
