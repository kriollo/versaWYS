{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "import", "unicorn", "promise", "oxc"],
    "env": {
        "builtin": true,
        "browser": true,
        "es2024": true,
        "commonjs": true,
        "node": true,
        "shared-node-browser": true
    },
    "categories": {
        "correctness": "error",
        "style": "warn",
        "perf": "warn",
        "pedantic": "warn",
        "restriction": "warn",
        "suspicious": "warn",
        "nursery": "off"
    },
    "globals": {
        // Vue 3 Composition API globals para <script setup>
        "defineProps": "readonly",
        "defineEmits": "readonly",
        "defineModel": "readonly",
        "defineSlots": "readonly",
        "withDefaults": "readonly",
        "defineOptions": "readonly",
        "defineExpose": "readonly",
        // Vue 3 reactivity globals
        "ref": "readonly",
        "reactive": "readonly",
        "computed": "readonly",
        "watch": "readonly",
        "watchEffect": "readonly",
        "provide": "readonly",
        "inject": "readonly",
        "onMounted": "readonly",
        "onUnmounted": "readonly",
        "onUpdated": "readonly",
        "nextTick": "readonly"
    },
    "rules": {
        "sort-imports": "off",
        "no-async-await": "off",
        "no-undefined": "off",
        "no-console": "off",
        "no-await-in-loop": "warn", // ⚠️ Puede causar problemas de rendimiento
        "func-style": "off",
        "no-plusplus": "off",
        "no-negated-condition": "off",
        "require-await": "warn", // ⚠️ async sin await puede ser confuso
        "oxc/no-optional-chaining": "off", // Permitir optional chaining (?.)
        "yoda": "off", // Permitir condiciones yoda para legibilidad
        // === TYPESCRIPT - REGLAS DE SEGURIDAD (cambiadas a warn) ===
        "typescript/no-unsafe-assignment": "warn", // 🚨 Puede ocultar errores de tipos
        "typescript/no-unsafe-call": "warn", // 🚨 Llamadas inseguras
        "typescript/no-unsafe-member-access": "warn", // 🚨 Acceso inseguro a propiedades
        "typescript/no-unsafe-return": "warn", // 🚨 Returns inseguros
        "typescript/restrict-plus-operands": "off",
        "typescript/restrict-template-expressions": "warn", // ⚠️ Evita [object Object] en templates
        "typescript/no-explicit-any": "off",
        "typescript/no-inferrable-types": "off",
        "typescript/ban-types": "off",
        "typescript/no-empty-object-type": "off",
        "typescript/prefer-nullish-coalescing": "off",
        "typescript/explicit-function-return-type": "off",
        "typescript/explicit-member-accessibility": "off",
        "typescript/method-signature-style": "off",
        // === UNICORN (Mejores prácticas modernas) ===
        "unicorn/empty-brace-spaces": "off",
        "unicorn/prefer-logical-operator-over-ternary": "off",
        "unicorn/prefer-modern-dom-apis": "off",
        "unicorn/prefer-ternary": "off",
        "unicorn/filename-case": "off",
        "unicorn/no-null": "off",
        "unicorn/prefer-global-this": "off",
        "unicorn/numeric-separators-style": "off",
        "unicorn/prefer-structured-clone": "off",
        // Reglas adicionales para evitar ruido
        "unicorn/no-array-for-each": "off",
        "unicorn/no-array-reduce": "off",
        "unicorn/prefer-dom-node-dataset": "off",
        "unicorn/no-negated-condition": "off",
        "unicorn/no-nested-ternary": "off",
        "unicorn/no-lonely-if": "off", // Permitir if anidados simples
        "unicorn/consistent-function-scoping": "off", // Permitir funciones anidadas para claridad
        // === IMPORT/EXPORT ===
        "import/no-named-default": "off",
        "import/no-default-export": "off",
        "import/exports-last": "off", // Puede ser molesto para módulos con exports en el medio
        "import/group-exports": "off", // Puede ser molesto para exports individuales
        "import/consistent-type-specifier-style": "off",
        "import/max-dependencies": "off",
        "import/unambiguous": "off", // Para archivos de tipos que no tienen imports/exports
        "import/no-named-export": "off",
        // === PROMISES ===
        "promise/prefer-await-to-then": "off", // finally() puede ser útil
        "promise/prefer-await-to-callbacks": "off", // callbacks a veces son útiles
        "promise/catch-or-return": "off", // finally() sin catch puede ser válido
        "promise/avoid-new": "off", // Evitar new Promise() puede ser restrictivo
        "sort-keys": "off",
        "no-magic-numbers": "off", // ⚠️ Sugiere usar constantes con nombre
        "max-lines-per-function": "off",
        "new-cap": "off",
        "no-ternary": "off",
        "no-rest-spread-properties": "off",
        // === REGLAS DE ESLINT DESHABILITADAS ===
        "eslint/max-nested-callbacks": [
            "error",
            {
                "max": 10
            }
        ],
        "eslint/max-depth": [
            "error",
            {
                "max": 10
            }
        ],
        "eslint/max-statements": "off",
        "eslint/no-inline-comments": "off",
        "eslint/sort-imports": "off",
        "eslint/max-lines": "off",
        "eslint/id-length": "off",
        "eslint/no-use-before-define": "off",
        "eslint/no-shadow": "off",
        "eslint/require-unicode-regexp": "off",
        "eslint/prefer-named-capture-group": "off",
        "eslint/no-underscore-dangle": "off",
        "eslint/logical-assignment-operators": "off",
        "eslint/class-methods-use-this": "off",
        "eslint/one-var": "off",
        "eslint/sort-vars": "off",
        "complexity": "off"
    },
    "ignorePatterns": ["dist/**", "node_modules/**", "*.config.js", "public/vendor/**"]
}
