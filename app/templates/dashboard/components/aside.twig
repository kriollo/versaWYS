<aside
    id="sidebar"
    class="fixed top-0 left-0 z-20 w-56 h-full pt-16 font-normal duration-75 transition-width bg-white dark:bg-[#0a0a0a] border-r border-gray-100 dark:border-gray-800 hidden lg:flex lg:flex-col lg:flex-shrink-0"
    aria-label="Sidebar">
    <div
        class="relative flex flex-col flex-1 min-h-0 pt-0 bg-white border-gray-200 dark:bg-[#0a0a0a] dark:border-gray-700 transform ease-in-out duration-500">
        <div class="flex flex-col flex-1 pb-4">
            <div class="flex-1 space-y-1 bg-white divide-y divide-gray-200 dark:bg-[#0a0a0a] dark:divide-gray-800 pt-5">
                <ul class="pb-2">
                    <li
                        id="liDropDownHome"
                        class="group/liDropDownHome hover:ml-4 hover:bg-gray-100 text-gray-900 dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand rounded-lg w-full transform ease-in-out duration-300 flex">
                        <versa-link
                            href="{{ getPanelUrl('dashboard') }}"
                            data-spa
                            class="flex p-2 w-full {{
                            url_actual == '/'
                                ? 'bg-gray-100 dark:bg-[#1a1a1a] dark:text-brand font-bold'
                                : ''
                            }}">
                            <div
                                class="flex-shrink-0 w-6 h-6 flex items-center justify-center transition duration-75 {{
                                url_actual == '/'
                                    ? 'text-black dark:text-brand'
                                    : 'text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand'
                                }}">
                                <svg
                                    class="w-6 h-6"
                                    aria-hidden="true"
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    fill="currentColor"
                                    viewbox="0 0 24 24"
                                    strokewidth="{1.5}">
                                    <path
                                        fill-rule="evenodd"
                                        d="M11.293 3.293a1 1 0 0 1 1.414 0l6 6 2 2a1 1 0 0 1-1.414 1.414L19 12.414V19a2 2 0 0 1-2 2h-3a1 1 0 0 1-1-1v-3h-2v3a1 1 0 0 1-1 1H7a2 2 0 0 1-2-2v-6.586l-.293.293a1 1 0 0 1-1.414-1.414l2-2 6-6Z"
                                        clip-rule="evenodd" />
                                </svg>
                            </div>
                            <span class="ml-3 lg:block hidden" sidebar-toggle-item>Home</span>
                        </versa-link>
                        <span
                            class="!hidden text-dark dark:text-white left-[100%] absolute bg-gray-200 dark:bg-gray-800 bg-gray rounded-lg space-y-2 p-2 tooltip-sidebar shadow-xl border border-gray-100 dark:border-gray-700 ml-2 z-50">
                            Home
                        </span>
                    </li>
                </ul>

                <ul class="pb-2">
                    {% set processed_menus = {} %}
                    {% set seccion = '' %}
                    {% for m in menu_user %}
                        {% set sectionLabel = m.seccion|trim|upper %}

                        {% if processed_menus[m.desc_menu] is not defined %}
                            {% set processed_menus =
                                processed_menus|merge({
                                    (m.desc_menu): true
                                })
                            %}

                            {% if sectionLabel != seccion %}
                                <li
                                    class="items-center p-2 rounded-lg group dark:text-gray-200 hidden lg:flex font-bold uppercase text-xs tracking-widest text-gray-500"
                                    sidebar-toggle-item>
                                    {{ sectionLabel }}
                                </li>
                                {% set seccion = sectionLabel %}
                            {% endif %}

                            {% set uniqueId = m.id_menu ~ '-' ~ sectionLabel %}

                            {% set hasSubmenus = false %}
                            {% for submenu_check in menu_user %}
                                {% if submenu_check.desc_menu == m.desc_menu and submenu_check.desc_submenu != '' %}
                                    {% set hasSubmenus = true %}
                                {% endif %}
                            {% endfor %}

                            <!-- Original ID and class structure preserved -->
                            <li
                                id="lisDropDown-{{ uniqueId }}"
                                class="{{
                                url_actual == m.url_menu or url_actual == m.url_submenu
                                    ? 'hover:ml-4 justify-start text-white w-full transform ease-in-out duration-300 flex bg-gray-100 dark:bg-[#1a1a1a] dark:text-brand text-dark sidebar-item rounded-lg group'
                                    : 'hover:ml-4 justify-start text-white w-full transform ease-in-out duration-300 flex sidebar-item group'
                                }} relative">
                                {% if not hasSubmenus %}
                                    <versa-link
                                        id="title-menu-{{ m.id_menu }}"
                                        href="{{ getPanelUrl('' ~ m.url_menu) }}"
                                        data-spa
                                        title="{{ m.desc_menu }}"
                                        class="group flex items-center p-2 text-base text-gray-900 transition duration-75 rounded-lg hover:bg-gray-100 group dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand w-full">
                                        <div
                                            class="flex-shrink-0 w-6 h-6 flex items-center justify-center transition duration-75 {{
                                            url_actual == m.url_menu
                                                ? 'text-black dark:text-brand'
                                                : 'text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand'
                                            }}">
                                            <svg
                                                class="w-6 h-6"
                                                aria-hidden="true"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                fill="{{ m.fill_menu == 1 ? 'currentColor' : 'none' }}"
                                                viewbox="0 0 24 24">
                                                {{ m.ico_menu|sanitizeSvg|raw }}
                                            </svg>
                                        </div>
                                        <span class="ml-3 lg:block hidden" sidebar-toggle-item>
                                            {{ m.desc_menu|capitalize }}
                                        </span>
                                        <span
                                            class="!hidden text-dark dark:text-white left-[100%] absolute bg-gray-200 dark:bg-gray-800 rounded-lg space-y-2 p-2 text-nowrap tooltip-sidebar shadow-xl border border-gray-100 dark:border-gray-700 ml-2 z-50">
                                            {{ m.desc_menu|capitalize }}
                                        </span>
                                    </versa-link>
                                {% else %}
                                    {% set isSubmenuActive = false %}
                                    {% for subcheck in menu_user %}
                                        {% if
                                            subcheck.desc_menu == m.desc_menu and subcheck.url_submenu == url_actual %}
                                            {% set isSubmenuActive = true %}
                                        {% endif %}
                                    {% endfor %}

                                    <button
                                        type="button"
                                        title="{{ m.desc_menu }}"
                                        class="flex items-center justify-between w-full p-2 text-base text-gray-900 transition duration-75 rounded-lg group hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand sidebar-item-button {{
                                        isSubmenuActive
                                            ? 'text-brand'
                                            : ''
                                        }}"
                                        aria-controls="dropdown-{{ uniqueId }}"
                                        data-collapse-toggle="dropdown-{{ uniqueId }}">
                                        <div class="flex">
                                            <div
                                                class="flex-shrink-0 w-6 h-6 flex items-center justify-center transition duration-75 {{
                                                isSubmenuActive
                                                    ? 'text-black dark:text-brand'
                                                    : 'text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand'
                                                }}">
                                                <svg
                                                    class="w-6 h-6"
                                                    aria-hidden="true"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    fill="{{ m.fill_menu == 1 ? 'currentColor' : 'none' }}"
                                                    viewbox="0 0 24 24">
                                                    {{ m.ico_menu|sanitizeSvg|raw }}
                                                </svg>
                                            </div>
                                            <span class="ml-3 lg:block hidden" sidebar-toggle-item>
                                                {{ m.desc_menu|capitalize }}
                                            </span>
                                            <span
                                                class="!hidden text-dark dark:text-white left-[100%] absolute bg-gray-200 dark:bg-gray-800 rounded-lg space-y-2 p-2 text-nowrap tooltip-sidebar shadow-xl border border-gray-100 dark:border-gray-700 ml-2 z-50">
                                                {{ m.desc_menu|capitalize }}
                                            </span>
                                        </div>
                                        <i
                                            class="bi bi-caret-right-fill text-xs transition-transform duration-200 group-hover:rotate-90 {{
                                            isSubmenuActive
                                                ? 'rotate-90 text-brand'
                                                : 'text-gray-400'
                                            }}"
                                            sidebar-item-i>

                                        </i>
                                    </button>

                                    <!-- Preserving the absolute positioning logic from original file -->
                                    <ul
                                        id="dropdown-{{ uniqueId }}"
                                        class="flex flex-col rounded-lg space-y-2 absolute left-[100%] top-0 z-30 bg-white dark:bg-[#0a0a0a] border border-gray-200 dark:border-gray-700 shadow-2xl min-w-max hidden group-hover:flex">
                                        {% for submenu in menu_user %}
                                            {% if submenu.desc_menu == m.desc_menu and submenu.desc_submenu != '' %}
                                                <li>
                                                    <versa-link
                                                        href="{{ getPanelUrl('' ~ submenu.url_submenu) }}"
                                                        data-spa
                                                        title="{{ submenu.desc_submenu }}"
                                                        class="flex items-center p-2 px-4 text-base text-gray-900 transition duration-75 rounded-lg group hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand {{
                                                        url_actual == submenu.url_submenu
                                                            ? 'bg-gray-100 dark:bg-[#1a1a1a] dark:text-brand font-bold'
                                                            : ''
                                                        }}">
                                                        <i
                                                            class="mr-3 text-xs {{ submenu.ico_submenu }} {{
                                                            url_actual == submenu.url_submenu
                                                                ? 'text-black dark:text-brand'
                                                                : 'text-gray-500 dark:text-gray-400'
                                                            }}"
                                                            aria-hidden="true">

                                                        </i>
                                                        {{ submenu.desc_submenu|capitalize }}
                                                    </versa-link>
                                                </li>
                                            {% endif %}
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>

                <div class="pt-2">
                    {% if current_user.role == 'admin' or current_user.role == 'superadmin' %}
                        <ul>
                            <!-- Usuarios -->
                            <li
                                id="liDropDownUser"
                                class="group/liDropDownUser hover:ml-4 hover:bg-gray-100 text-gray-900 dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand rounded-lg w-full transform ease-in-out duration-300 flex">
                                <versa-link
                                    href="{{ getPanelUrl('usuarios') }}"
                                    data-spa
                                    class="flex p-2 w-full {{
                                    url_actual == 'usuarios'
                                        ? 'bg-gray-100 dark:bg-[#1a1a1a] dark:text-brand font-bold'
                                        : ''
                                    }}">
                                    <div
                                        class="flex-shrink-0 w-6 h-6 flex items-center justify-center transition duration-75 {{
                                        url_actual == getPanelUrl('usuarios')
                                            ? 'text-black dark:text-brand'
                                            : 'text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand'
                                        }}">
                                        <svg
                                            class="w-6 h-6"
                                            aria-hidden="true"
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            fill="currentColor"
                                            viewbox="0 0 24 24"
                                            strokewidth="{1.5}">
                                            <path
                                                fill-rule="evenodd"
                                                d="M8 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-2 9a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1a4 4 0 0 0-4-4H6Zm7.25-2.095c.478-.86.75-1.85.75-2.905a5.973 5.973 0 0 0-.75-2.906 4 4 0 1 1 0 5.811ZM15.466 20c.34-.588.535-1.271.535-2v-1a5.978 5.978 0 0 0-1.528-4H18a4 4 0 0 1 4 4v1a2 2 0 0 1-2 2h-4.535Z"
                                                clip-rule="evenodd" />
                                        </svg>
                                    </div>
                                    <span class="ml-3 lg:block hidden" sidebar-toggle-item>Usuarios</span>
                                </versa-link>
                                <span
                                    class="!hidden text-dark dark:text-white left-[100%] absolute bg-gray-200 dark:bg-gray-800 rounded-lg space-y-2 p-2 tooltip-sidebar shadow-xl border border-gray-100 dark:border-gray-700 ml-2 z-50">
                                    Usuarios
                                </span>
                            </li>
                            <!-- Perfiles -->
                            <li
                                id="liDropDownPerfiles"
                                class="group/liDropDownPerfiles hover:ml-4 hover:bg-gray-100 text-gray-900 dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand rounded-lg w-full transform ease-in-out duration-300 flex">
                                <versa-link
                                    href="{{ getPanelUrl('perfiles') }}"
                                    data-spa
                                    class="flex p-2 w-full {{
                                    url_actual == getPanelUrl('perfiles')
                                        ? 'bg-gray-100 dark:bg-[#1a1a1a] dark:text-brand font-bold'
                                        : ''
                                    }}">
                                    <div
                                        class="flex-shrink-0 w-6 h-6 flex items-center justify-center transition duration-75 {{
                                        url_actual == 'perfiles'
                                            ? 'text-black dark:text-brand'
                                            : 'text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand'
                                        }}">
                                        <svg
                                            class="w-6 h-6"
                                            aria-hidden="true"
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            fill="currentColor"
                                            viewbox="0 0 24 24"
                                            strokewidth="{1.5}">
                                            <path
                                                d="M10.83 5a3.001 3.001 0 0 0-5.66 0H4a1 1 0 1 0 0 2h1.17a3.001 3.001 0 0 0 5.66 0H20a1 1 0 1 0 0-2h-9.17ZM4 11h9.17a3.001 3.001 0 0 1 5.66 0H20a1 1 0 1 1 0 2h-1.17a3.001 3.001 0 0 1-5.66 0H4a1 1 0 1 1 0-2Zm1.17 6H4a1 1 0 1 0 0 2h1.17a3.001 3.001 0 0 0 5.66 0H20a1 1 0 1 0 0-2h-9.17a3.001 3.001 0 0 0-5.66 0Z" />
                                        </svg>
                                    </div>
                                    <span class="ml-3 lg:block hidden" sidebar-toggle-item>Perfiles</span>
                                </versa-link>
                                <span
                                    class="!hidden text-dark dark:text-white left-[100%] absolute bg-gray-200 dark:bg-gray-800 rounded-lg space-y-2 p-2 tooltip-sidebar shadow-xl border border-gray-100 dark:border-gray-700 ml-2 z-50">
                                    Perfiles
                                </span>
                            </li>
                            {% if current_user.role == 'superadmin' %}
                                <!-- Empresas -->
                                <li
                                    id="liDropDownEmpresas"
                                    class="group/liDropDownEmpresas hover:ml-4 hover:bg-gray-100 text-gray-900 dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand rounded-lg w-full transform ease-in-out duration-300 flex">
                                    <versa-link
                                        href="{{ getPanelUrl('empresas') }}"
                                        data-spa
                                        class="flex p-2 w-full {{
                                        url_actual == 'empresas'
                                            ? 'bg-gray-100 dark:bg-[#1a1a1a] dark:text-brand font-bold'
                                            : ''
                                        }}">
                                        <div
                                            class="flex-shrink-0 w-6 h-6 flex items-center justify-center transition duration-75 {{
                                            url_actual == getPanelUrl('empresas')
                                                ? 'text-black dark:text-brand'
                                                : 'text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand'
                                            }}">
                                            <svg
                                                class="w-6 h-6"
                                                aria-hidden="true"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                fill="none"
                                                viewbox="0 0 24 24">
                                                <path
                                                    stroke="currentColor"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M7 6H5m2 3H5m2 3H5m2 3H5m2 3H5m11-1a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2M7 3h11a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm8 7a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z" />
                                            </svg>
                                        </div>
                                        <span class="ml-3 lg:block hidden" sidebar-toggle-item>Empresas</span>
                                    </versa-link>
                                    <span
                                        class="!hidden text-dark dark:text-white left-[100%] absolute bg-gray-200 dark:bg-gray-800 rounded-lg space-y-2 p-2 tooltip-sidebar shadow-xl border border-gray-100 dark:border-gray-700 ml-2 z-50">
                                        Empresas
                                    </span>
                                </li>


                                <!-- Módulos -->
                                <li
                                    id="liDropDownModulos"
                                    class="group/liDropDownModulos hover:ml-4 hover:bg-gray-100 text-gray-900 dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand rounded-lg w-full transform ease-in-out duration-300 flex">
                                    <versa-link
                                        href="{{ getPanelUrl('modulesRoutes') }}"
                                        data-spa
                                        class="flex p-2 w-full {{
                                        url_actual == 'modulesRoutes'
                                            ? 'bg-gray-100 dark:bg-[#1a1a1a] dark:text-brand font-bold'
                                            : ''
                                        }}">
                                        <div
                                            class="flex-shrink-0 w-6 h-6 flex items-center justify-center transition duration-75 {{
                                            url_actual == 'modulesRoutes'
                                                ? 'text-black dark:text-brand'
                                                : 'text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand'
                                            }}">
                                            <svg
                                                class="w-6 h-6"
                                                aria-hidden="true"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                fill="currentColor"
                                                viewbox="0 0 24 24"
                                                strokewidth="{1.5}">
                                                <path
                                                    fill-rule="evenodd"
                                                    d="M4.857 3A1.857 1.857 0 0 0 3 4.857v4.286C3 10.169 3.831 11 4.857 11h4.286A1.857 1.857 0 0 0 11 9.143V4.857A1.857 1.857 0 0 0 9.143 3H4.857Zm10 0A1.857 1.857 0 0 0 13 4.857v4.286c0 1.026.831 1.857 1.857 1.857h4.286A1.857 1.857 0 0 0 21 9.143V4.857A1.857 1.857 0 0 0 19.143 3h-4.286Zm-10 10A1.857 1.857 0 0 0 3 14.857v4.286C3 20.169 3.831 21 4.857 21h4.286A1.857 1.857 0 0 0 11 19.143v-4.286A1.857 1.857 0 0 0 9.143 13H4.857Zm10 0A1.857 1.857 0 0 0 13 14.857v4.286c0 1.026.831 1.857 1.857 1.857h4.286A1.857 1.857 0 0 0 21 19.143v-4.286A1.857 1.857 0 0 0 19.143 13h-4.286Z"
                                                    clip-rule="evenodd" />
                                            </svg>
                                        </div>
                                        <span class="ml-3 lg:block hidden" sidebar-toggle-item>Módulos</span>
                                    </versa-link>
                                    <span
                                        class="!hidden text-dark dark:text-white left-[100%] absolute bg-gray-200 dark:bg-gray-800 rounded-lg space-y-2 p-2 tooltip-sidebar shadow-xl border border-gray-100 dark:border-gray-700 ml-2 z-50">
                                        Módulos
                                    </span>
                                </li>
                                <!-- Configuración -->
                                <li
                                    id="liDropDownConfiguracion"
                                    class="group/liDropDownConfiguracion hover:ml-4 hover:bg-gray-100 text-gray-900 dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand rounded-lg w-full transform ease-in-out duration-300 flex">
                                    <versa-link
                                        href="{{ getPanelUrl('configuracionRoutes') }}"
                                        data-spa
                                        class="flex p-2 w-full {{
                                        url_actual == 'configuracionRoutes'
                                            ? 'bg-gray-100 dark:bg-[#1a1a1a] dark:text-brand font-bold'
                                            : ''
                                        }}">
                                        <div
                                            class="flex-shrink-0 w-6 h-6 flex items-center justify-center transition duration-75 {{
                                            url_actual == 'configuracionRoutes'
                                                ? 'text-black dark:text-brand'
                                                : 'text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand'
                                            }}">
                                            <svg
                                                class="w-6 h-6"
                                                aria-hidden="true"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                fill="none"
                                                viewbox="0 0 24 24"
                                                strokewidth="{1.5}">
                                                <path
                                                    stroke="currentColor"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="1.5"
                                                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065Z" />
                                                <path
                                                    stroke="currentColor"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="1.5"
                                                    d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                            </svg>
                                        </div>
                                        <span class="ml-3 lg:block hidden" sidebar-toggle-item>Configuración</span>
                                    </versa-link>
                                    <span
                                        class="!hidden text-dark dark:text-white left-[100%] absolute bg-gray-200 dark:bg-gray-800 rounded-lg space-y-2 p-2 tooltip-sidebar shadow-xl border border-gray-100 dark:border-gray-700 ml-2 z-50">
                                        Configuración
                                    </span>
                                </li>

                                {% if config['build']['debug'] == '1' %}
                                    <!-- Documentación -->
                                    <li
                                        id="liDropDownDocumentacion"
                                        class="group/liDropDownDocumentacion hover:ml-4 hover:bg-gray-100 text-gray-900 dark:text-gray-200 dark:hover:bg-[#1a1a1a] dark:hover:text-brand rounded-lg w-full transform ease-in-out duration-300 flex">
                                        <versa-link href="/doc" data-spa class="flex p-2 w-full">
                                            <div
                                                class="flex-shrink-0 w-6 h-6 flex items-center justify-center transition duration-75 text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand">
                                                <svg
                                                    class="w-6 h-6"
                                                    aria-hidden="true"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="24"
                                                    height="24"
                                                    fill="none"
                                                    viewbox="0 0 24 24"
                                                    strokewidth="{1.5}">
                                                    <path
                                                        stroke="currentColor"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M12 6.03v13m0-13c-2.819-.831-4.715-1.076-8.029-1.023A.99.99 0 0 0 3 6v11c0 .563.466 1.014 1.03 1.007 3.122-.043 5.018.212 7.97 1.023m0-13c2.819-.831 4.715-1.076 8.029-1.023A.99.99 0 0 1 21 6v11c0 .563-.466 1.014-1.03 1.007-3.122-.043-5.018.212-7.97 1.023" />
                                                </svg>
                                            </div>
                                            <span class="ml-3 lg:block hidden" sidebar-toggle-item>Documentación</span>
