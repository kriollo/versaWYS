<nav
    class="fixed z-30 w-full bg-white border-b border-gray-200 dark:bg-[#0a0a0a] dark:border-gray-800 transition-colors duration-200">
    <div class="px-3 py-3 lg:px-5 lg:pl-3">
        <div class="flex items-center justify-between">
            <div class="flex items-center justify-start">
                <a href="{{ getPanelUrl('dashboard') }}" data-spa class="flex mx-2 md:mr-4 group" title="VersaWYS">
                    <img
                        src="{{ getAssets('dashboard', 'img', '/favicon.png') }}"
                        class="h-12 mr-3 transition-transform group-hover:scale-105"
                        alt="VERSABOT Logo" />
                    <span
                        class="hidden md:flex self-center text-xl font-bold sm:text-2xl whitespace-nowrap dark:text-white tracking-tight">
                        {% set _app_name_parts = config.build.name|split(' ') %}
                        {% for _part in _app_name_parts %}
                            {% if loop.last %}
                                <span class="text-brand">{{ _part }}</span>
                            {% else %}
                                {{ _part }}
                            {% endif %}
                        {% endfor %}
                    </span>
                </a>
                <!-- toggle aside -->
                <div class="flex items-center">
                    <button
                        id="toggleAside"
                        aria-expanded="true"
                        aria-controls="sidebar"
                        class="p-2 text-gray-600 rounded cursor-pointer hover:text-gray-900 hover:bg-gray-100 focus:bg-gray-100 dark:focus:bg-[#1a1a1a] focus:ring-2 focus:ring-gray-100 dark:focus:ring-gray-700 dark:text-gray-400 dark:hover:bg-[#1a1a1a] dark:hover:text-brand flex justify-center items-center transition-all duration-200">
                        <svg
                            id="toggleAsideHamburger"
                            class="w-[28px] h-[28px] text-gray-800 dark:text-white transform duration-300 rotate-90"
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            fill="currentColor"
                            viewbox="0 0 24 24">
                            <path
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-width="1"
                                d="M5 7h14M5 12h14M5 17h14" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <div class="hidden mr-3 -mb-1 sm:block">
                    {% if current_user.role != 'superadmin' %}
                        <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
                            {{ current_user.empresa }}
                            <input type="hidden" id="selectEmpresa" value="{{ current_user.token_empresa }}" />
                        </span>
                    {% else %}
                        <form
                            id="formSelectEmpresa"
                            action="{{ getPanelUrl('selectempresa') }}"
                            method="post"
                            class="flex items-center">
                            {{ csrf_field('crsf_token_empresa')|raw }}
                            <input type="hidden" name="urlActual" value="{{ url_actual }}" />
                            <select
                                name="selectEmpresa"
                                id="selectEmpresa"
                                class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-brand focus:border-brand block w-full p-2.5 dark:bg-[#1a1a1a] dark:border-gray-700 dark:placeholder-gray-400 dark:text-gray-200 dark:focus:ring-brand dark:focus:border-brand transition-colors"
                                data-auto-submit>
                                {% set empresaSelectedToken = empresaSelected.token_empresa
                                    ?? current_user.token_empresa
                                %}
                                {% for empresa in empresas %}
                                    <option
                                        value="{{ empresa.token_empresa }}"
                                        {{ empresa.token_empresa == empresaSelectedToken ? 'selected' : '' }}>
                                        {{ empresa.nombre }}
                                    </option>
                                {% endfor %}
                            </select>
                        </form>
                    {% endif %}
                </div>
                <button
                    id="theme-toggle"
                    data-tooltip-target="tooltip-toggle"
                    type="button"
                    class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-[#1a1a1a] dark:hover:text-brand focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 transition-all duration-200">
                    <svg
                        id="theme-toggle-dark-icon"
                        class="hidden w-5 h-5"
                        fill="currentColor"
                        viewbox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg">
                        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                    </svg>
                    <svg
                        id="theme-toggle-light-icon"
                        class="hidden w-5 h-5"
                        fill="currentColor"
                        viewbox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                            fill-rule="evenodd"
                            clip-rule="evenodd"></path>
                    </svg>
                </button>
                <div
                    id="tooltip-toggle"
                    role="tooltip"
                    class="absolute z-10 inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm tooltip opacity-0 invisible"
                    data-popper-placement="bottom">
                    Toggle dark mode<div class="tooltip-arrow" data-popper-arrow=""></div>
                </div>
                <div class="flex items-center ml-3">
                    <div>
                        <button
                            type="button"
                            class="flex text-sm rounded-full border-2 border-black focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600 dark:border-brand transition-colors"
                            id="user-menu-button-2"
                            aria-expanded="false"
                            data-dropdown-toggle="dropdown">
                            <span class="sr-only">Open user menu</span>
                            {% if current_user.avatar != null %}
                                <img
                                    class="w-8 h-8 rounded-full border-2 border-transparent"
                                    src="{{ getAssets('dashboard', 'avatars', '/' ~ current_user.avatar) }}"
                                    alt="{{ current_user.name }}" />
                            {% else %}
                                <img
                                    class="w-8 h-8 rounded-full border-2 border-transparent dark:invert"
                                    src="{{ getAssets('dashboard', 'avatars', '/incognito-icon-20.jpg') }}"
                                    alt="{{ current_user.name }}" />
                            {% endif %}
                        </button>
                    </div>

                    <div
                        class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100 rounded shadow dark:bg-[#1a1a1a] dark:divide-gray-700 min-w-[200px] border border-gray-100 dark:border-gray-700"
                        id="dropdown"
                        data-popper-placement="bottom">
                        <div class="px-4 py-3" role="none">
                            <p class="text-sm text-gray-900 dark:text-white font-bold" role="none">
                                {{ current_user.name }}
                            </p>
                            <p class="text-xs font-medium text-gray-500 truncate dark:text-gray-400" role="none">
                                {{ current_user.email }}
                            </p>
                        </div>
                        <ul class="py-1" role="none">
                            <li>
                                <versa-link
                                    href="{{ getPanelUrl('perfiluser') }}"
                                    data-preserve-scroll="true"
                                    data-preserve-state="false"
                                    class="block py-2 px-4 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-[#0a0a0a] dark:hover:text-brand transition-colors"
                                    role="menuitem">
                                    <div class="flex gap-2 items-center">
                                        <svg
                                            class="w-5 h-5 text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand"
                                            aria-hidden="true"
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewbox="0 0 24 24">
                                            <path
                                                stroke="currentColor"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M10 19H5a1 1 0 0 1-1-1v-1a3 3 0 0 1 3-3h2m10 1a3 3 0 0 1-3 3m3-3a3 3 0 0 0-3-3m3 3h1m-4 3a3 3 0 0 1-3-3m3 3v1m-3-4a3 3 0 0 1 3-3m-3 3h-1m4-3v-1m-2.121 1.879-.707-.707m5.656 5.656-.707-.707m-4.242 0-.707.707m5.656-5.656-.707.707M12 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                        </svg>
                                        <span>Perfil</span>
                                    </div>
                                </versa-link>
                            </li>
                            <li>
                                <form method="post" action="{{ getPanelUrl('logout') }}">
                                    {{ csrf_field('csrf_token_logout')|raw }}
                                    <button
                                        type="submit"
                                        class="w-full text-left block py-2 px-4 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-[#0a0a0a] dark:hover:text-brand transition-colors"
                                        role="menuitem">
                                    <div class="flex gap-2 items-center">
                                        <svg
                                            class="w-5 h-5 text-gray-500 dark:text-gray-400 group-hover:text-black dark:group-hover:text-brand"
                                            aria-hidden="true"
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewbox="0 0 24 24">
                                            <path
                                                stroke="currentColor"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M20 12H8m12 0-4 4m4-4-4-4M9 4H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h2" />
                                        </svg>
                                        <span>Salir</span>
                                    </div>
                                </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</nav>
