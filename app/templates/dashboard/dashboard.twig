{% extends 'dashboard/layout/layout.twig' %}
{% block appHead %}
<style>
/* sr-only inputs inside labels need a positioned parent so scrollIntoView
   targets the label (visible) instead of the fixed container (viewport top). */
#main-content label { position: relative; }
</style>
{% endblock %}
{% block appBody %}
    {% include 'dashboard/components/nav.twig' %}
    <div class="fixed inset-0 flex overflow-hidden pt-16 bg-gray-50 dark:bg-[#050505]">
        {% include 'dashboard/components/aside.twig' %}
        <div
            class="fixed inset-0 z-10 hidden bg-gray-900/50 dark:bg-black/80 backdrop-blur-xs"
            id="sidebarBackdrop"></div>

        <div
            id="main"
            class="flex-1 lg:ml-56 dark:bg-[#050505] flex flex-col transition-all duration-300 overflow-hidden">
            <div id="main-content" class="flex-1 min-h-0 p-6 overflow-auto">
                {% block appDashboard %}

                {% endblock %}
            </div>
            {% include 'dashboard/components/footer.twig' %}
        </div>
    </div>
{% endblock %}

{% block appScript %}

{% endblock %}
