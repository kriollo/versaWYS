{% extends 'dashboard/login/layoutLogin.twig' %}
{% block loginBody %}
	<div class="w-full" id="alert"></div>

	<h2 class="text-xl font-bold text-white mb-6">Ingresar a la plataforma</h2>

	<form class="space-y-5" id="formulario">
		{{ csrf_field()|raw }}

		{# Email Input #}
		<div>
			<label for="email" class="block mb-2 text-sm font-medium text-gray-400">
				Correo
			</label>
			<input type="email" name="email" id="email" class="bg-[#1a1a1a] border border-gray-700 text-white text-sm rounded-lg focus:ring-brand focus:border-brand block w-full p-3 placeholder-gray-500 transition-colors" placeholder="name@company.com" required/>
		</div>

		{# Password Input #}
		<div>
			<label for="password" class="block mb-2 text-sm font-medium text-gray-400">
				Contraseña
			</label>
			<div class="relative">
				<input type="password" name="password" id="password" placeholder="••••••••" autocomplete="current-password" class="bg-[#1a1a1a] border border-gray-700 text-white text-sm rounded-lg focus:ring-brand focus:border-brand block w-full p-3 pr-10 placeholder-gray-500 transition-colors" required/>
				<button type="button" id="togglePassword" aria-label="Mostrar u ocultar contraseña" class="absolute top-1/2 right-3 -translate-y-1/2 cursor-pointer text-gray-500 hover:text-brand transition-colors">
					<svg class="hidden w-5 h-5" id="imgShowPass" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 20 18">
						<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1.933 10.909A4.357 4.357 0 0 1 1 9c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 19 9c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M2 17 18 1m-5 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
					</svg>
					<svg class="w-5 h-5" id="imgHiddenPass" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 20 14">
						<g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
							<path d="M10 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
							<path d="M10 13c4.97 0 9-2.686 9-6s-4.03-6-9-6-9 2.686-9 6 4.03 6 9 6Z"/>
						</g>
					</svg>
				</button>
			</div>
		</div>

		{# Remember Me #}
		<div class="flex items-center">
			<input id="remember" name="remember" type="checkbox" class="w-4 h-4 border-gray-600 rounded bg-gray-700 text-brand focus:ring-brand focus:ring-offset-gray-800"/>
			<label for="remember" class="ml-2 text-sm text-gray-400">
				Recuérdame
			</label>
		</div>

		{# Actions #}
		<div class="flex items-center justify-between pt-2">
			<button type="button" id="login" class="px-6 py-2.5 text-sm font-bold text-white bg-brand rounded-lg hover:bg-brand-600 focus:ring-4 focus:ring-brand/50 transition-all duration-200">
				Acceder
			</button>
			<a href="{{ getPanelUrl('lost-password') }}" data-spa class="text-sm text-brand hover:underline">
				he perdido la Contraseña?
			</a>
		</div>

		{# Back to Home #}
		<div class="pt-4">
			<a href="/" class="inline-flex items-center text-sm text-gray-400 hover:text-brand transition-colors" id="linkBack">
				<svg class="w-4 h-4 mr-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 6 10">
					<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4"/>
				</svg>
				Volver al Home
			</a>
		</div>
	</form>
{% endblock %}
