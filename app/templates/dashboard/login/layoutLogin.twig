{% extends 'dashboard/layout/layout.twig' %}
{% block appHeader %}
    <style>
        .logo-container { overflow: visible; padding: 24px; margin: -24px; margin-bottom: 1rem; } .frame-zoom {
        transform-origin: center; animation: frameRotate 3s cubic-bezier(0.4, 0, 0.2, 1) forwards; will-change:
        transform; backface-visibility: hidden; } .login-card { background: rgba(18, 18, 23, 0.85); backdrop-filter:
        blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; box-shadow: 0 25px 50px -12px
        rgba(0, 0, 0, 0.8); } @keyframes frameRotate { 0% { transform: rotate(0deg) scale(0.5); opacity: 0; } 15% {
        transform: rotate(180deg) scale(0.8); opacity: 0.5; } 30% { transform: rotate(360deg) scale(1); opacity: 1; }
        45% { transform: rotate(540deg) scale(1.05); } 60% { transform: rotate(720deg) scale(1); } 75% { transform:
        rotate(900deg) scale(1.02); } 90% { transform: rotate(1080deg) scale(1); } 100% { transform: rotate(1080deg)
        scale(1); } } @keyframes letterReveal { 0% { opacity: 1; clip-path: inset(0% 0% 0% 0%); filter: blur(8px); } 10%
        { opacity: 0; clip-path: inset(50% 50% 50% 50%); filter: blur(12px); } 25% { opacity: 1; clip-path: inset(0% 0%
        0% 0%); filter: blur(6px); } 35% { opacity: 0; clip-path: inset(50% 50% 50% 50%); filter: blur(10px); } 50% {
        opacity: 1; clip-path: inset(0% 0% 0% 0%); filter: blur(4px); } 60% { opacity: 0; clip-path: inset(50% 50% 50%
        50%); filter: blur(8px); } 75% { opacity: 1; clip-path: inset(0% 0% 0% 0%); filter: blur(2px); } 100% { opacity:
        1; clip-path: inset(0% 0% 0% 0%); filter: blur(0px); } }
    </style>
{% endblock %}
{% block appBody %}
    <div class="fixed inset-0 w-full h-full z-0">
        <div
            class="w-full h-full bg-cover bg-center"
            style="background-image: url('{{ assets_url('/public/dashboard/img/loginBackground.png') }}');"></div>
    </div>

    {# Main Content #}
    <div class="relative z-10 min-h-screen flex flex-col items-center justify-center p-4">
        {# Logo - Centered above card #}
        <div class="transform hover:scale-105 transition-transform duration-500 logo-container">
            <img
                src="{{ assets_url('/public/dashboard/img/favicon.png') }}"
                alt="{{ config.build.name }}"
                class="w-24 h-auto frame-zoom" />
        </div>

        {# Login Card #}
        <div class="absolute inset-0 w-full h-full backdrop-blur-[2px] bg-black/50 -z-10"></div>
        <div class="login-card w-full max-w-[450px] p-8 md:p-10 relative">
            {# Theme Toggle - Centered inside card at bottom or top right if preferred (Keeping clean for now as per design) #}
            <div class="absolute top-4 right-4">
                <button
                    id="theme-toggle"
                    type="button"
                    class="text-gray-500 hover:text-brand transition-colors focus:outline-none rounded-lg text-sm p-1">
                    <svg
                        id="theme-toggle-dark-icon"
                        class="hidden w-4 h-4"
                        fill="currentColor"
                        viewbox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg">
                        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                    </svg>
                    <svg
                        id="theme-toggle-light-icon"
                        class="hidden w-4 h-4"
                        fill="currentColor"
                        viewbox="0 0 20 20"
                        xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                            clip-rule="evenodd"
                            fill-rule="evenodd"></path>
                    </svg>
                </button>
            </div>

            {% block loginBody %}

            {% endblock %}
        </div>
    </div>
{% endblock %}
{% block appScript %}
    <script nonce="{{ csp_nonce() }}" type="module" src="{{ getAssets('dashboard', 'js', '/login/login.js') }}?v={{ config.build.debug ? 'now'|date('U') : config.build.version }}"></script>
{% endblock %}
