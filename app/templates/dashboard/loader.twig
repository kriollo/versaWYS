{% extends "dashboard/dashboard.twig" %}
{% block appDashboard %}
	{% include 'dashboard/spa-content.twig' %}

{% endblock %}
{% block appScript %}
	{# Variable global para SessionManager - indica si hay una sesión activa #}
	<script nonce="{{ csp_nonce() }}">
		window.versaSessionActive = {{ hasActiveSession ? 'true' : 'false' }};
	</script>
	{{ parent() }}
	<script nonce="{{ csp_nonce() }}" type="module" src="{{ getAssets('dashboard', 'js', '/vue-loader.js') }}?v={{ config.build.debug ? 'now'|date('U') : config.build.version }}&m={{m}}"></script>
{% endblock %}
