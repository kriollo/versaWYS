{% extends 'dashboard/layout/layout.twig' %}
{% block appHead %}
    <style>
        .doc-shell { --doc-accent: #19a985; font-family: 'Lato', sans-serif; }

        .doc-code { font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; font-variant-ligatures: none;
        }

        .doc-route { transition: border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease; }

        .doc-route:hover { border-color: rgb(20 184 166 / 42%); box-shadow: 0 10px 26px rgb(15 23 42 / 7%); }

        .doc-group { background: radial-gradient(ellipse at top left, rgb(20 184 166 / 13%), transparent 55%), #10252f;
        }

        .dark .doc-group { background: radial-gradient(ellipse at top left, rgb(20 184 166 / 16%), transparent 55%),
        #0c1b23; }

        .doc-enter { animation: doc-enter 320ms ease-out both; }

        @keyframes doc-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform:
        translateY(0); } }

        @media (prefers-reduced-motion: reduce) { .doc-route, .doc-enter { animation: none; transition: none; } }

        .rt-tab { margin-bottom: -1px; border-bottom: 2px solid transparent; padding: 0.5rem 0.75rem; font-size: 0.75rem;
        font-weight: 700; color: #475569; }

        .rt-tab:hover { color: #0f172a; }

        .rt-tab[aria-selected='true'] { border-bottom-color: #0f766e; color: #0f766e; }

        .dark .rt-tab { color: #cbd5e1; }

        .dark .rt-tab:hover { color: #ffffff; }

        .dark .rt-tab[aria-selected='true'] { border-bottom-color: #5eead4; color: #5eead4; }

        .rt-count { margin-left: 0.25rem; font-weight: 400; opacity: 0.75; }

        .rt-link { font-size: 0.75rem; font-weight: 700; color: #0f766e; }

        .rt-link:hover { text-decoration: underline; }

        .dark .rt-link { color: #5eead4; }

        .rt-json details > summary { cursor: pointer; list-style: none; }

        .rt-json details > summary::before { content: '▸'; display: inline-block; width: 1em; color: #64748b; }

        .rt-json details[open] > summary::before { content: '▾'; }

        .rt-json .rt-children { margin-left: 1.25em; border-left: 1px solid rgb(100 116 139 / 30%); padding-left: 0.75em; }

        .rt-json .rt-leaf { padding-left: 1em; }

        .rt-json { color: #334155; }

        .rt-json .k { color: #7c2d12; } .rt-json .s { color: #166534; } .rt-json .n { color: #1d4ed8; } .rt-json .b {
        color: #7e22ce; } .rt-json .z { color: #64748b; }

        .dark .rt-json { color: #cbd5e1; }

        .dark .rt-json .k { color: #fdba74; } .dark .rt-json .s { color: #86efac; } .dark .rt-json .n { color: #93c5fd; }
        .dark .rt-json .b { color: #d8b4fe; } .dark .rt-json .z { color: #94a3b8; }
    </style>
{% endblock %}
{% block appBody %}
    <div
        class="doc-shell min-h-full w-full bg-slate-100 px-4 py-6 text-slate-800 dark:bg-gray-950 dark:text-slate-100 sm:px-6 lg:px-10">
        {{ csrf_field('csrf_token')|raw }}
        <div class="mx-auto max-w-7xl">
            <header class="mb-8">
                <div class="flex flex-wrap items-center gap-3">
                    <div
                        class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-900 shadow-lg shadow-slate-900/15 dark:bg-teal-950">
                        <img class="h-6 w-6" src="/public/dashboard/img/favicon.webp" alt="VersaWYS Framework" />
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-teal-700 dark:text-teal-300">
                            VersaWYS · Herramientas de desarrollo
                        </p>
                        <h1
                            class="mt-0.5 text-2xl font-black tracking-tight text-slate-950 dark:text-white sm:text-3xl">
                            Explorador de rutas
                        </h1>
                    </div>
                    <span
                        class="rounded-full border border-slate-300 bg-white px-3 py-1 text-xs font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                        v{{ config['build']['version'] }}
                    </span>
                    <span
                        class="rounded-full border border-teal-700/20 bg-teal-50 px-3 py-1 text-xs font-bold text-teal-800 dark:border-teal-300/20 dark:bg-teal-950 dark:text-teal-200">
                        Documentación
                    </span>
                </div>
                <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
                    Explora endpoints, grupos, controladores y parámetros desde una sola vista.
                </p>
            </header>

            {% if (opcionActual|length) > 0 %}
                <nav aria-label="Ruta de navegación" class="mb-5 flex flex-wrap items-center gap-2 text-sm">
                    {% for opcion in opcionActual %}
                        {% if not loop.last %}
                            <versa-link
                                href="{{ opcion.link }}"
                                data-spa
                                class="font-semibold text-teal-800 transition hover:text-teal-600 dark:text-teal-300 dark:hover:text-teal-200">
                                {{ opcion.name }}
                            </versa-link>
                            <span aria-hidden="true" class="text-slate-400">/</span>
                        {% else %}
                            <span class="font-semibold text-slate-500 dark:text-slate-400">{{ opcion.name }}</span>
                        {% endif %}
                    {% endfor %}
                </nav>
            {% endif %}

            {% if (routesFiles|length) > 0 %}
                <section
                    aria-labelledby="route-files-title"
                    class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs dark:border-slate-800 dark:bg-slate-900 sm:p-7">
                    <div class="flex flex-wrap items-end justify-between gap-4">
                        <div>
                            <p class="text-xs font-bold uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">
                                Catálogo de rutas
                            </p>
                            <h2 id="route-files-title" class="mt-1 text-xl font-bold text-slate-950 dark:text-white">
                                Archivos de rutas
                            </h2>
                            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                                Selecciona un archivo para explorar sus endpoints.
                            </p>
                        </div>
                        <span
                            class="rounded-lg bg-slate-100 px-3 py-2 text-sm font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                            {{ routesFiles|length }} archivos
                        </span>
                    </div>
                    <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                        {% for file in ['all']|merge(routesFiles) %}
                            {% set summary = routesSummary[file] ?? { routes: 0, errors: 0, warnings: 0 } %}
                            <versa-link
                                href="?route={{ file|url_encode }}"
                                data-spa
                                class="group flex min-h-20 items-center justify-between gap-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 transition hover:-translate-y-0.5 hover:border-teal-500/60 hover:bg-white hover:shadow-md dark:border-slate-800 dark:bg-slate-950 dark:hover:border-teal-500/60 dark:hover:bg-slate-900">
                                <span class="flex min-w-0 items-center gap-3">
                                    <span
                                        class="doc-code flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-[10px] font-bold text-teal-300 dark:bg-teal-950">
                                        PHP
                                    </span>
                                    <span
                                        class="truncate text-sm font-bold text-slate-800 group-hover:text-teal-800 dark:text-slate-200 dark:group-hover:text-teal-300">
                                        {{ file == 'all' ? 'Todas las rutas' : file }}
                                        <span class="block text-xs font-medium text-slate-500 dark:text-slate-400">
                                            {{ summary.routes }} rutas
                                            {%- if summary.errors > 0 %}
                                                · <span class="font-bold text-rose-700 dark:text-rose-300">{{ summary.errors }} con error</span>
                                            {%- endif %}
                                            {%- if summary.warnings > 0 %}
                                                · <span class="text-amber-700 dark:text-amber-300">{{ summary.warnings }} sin documentar</span>
                                            {%- endif %}
                                        </span>
                                    </span>
                                </span>
                                <span
                                    aria-hidden="true"
                                    class="text-lg text-slate-400 transition group-hover:translate-x-1 group-hover:text-teal-600">
                                    →
                                </span>
                            </versa-link>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {% if (routesFromRouteFile|length) > 0 %}
                {% set lastOption = opcionActual|last %}
                <section
                    aria-labelledby="route-list-title"
                    class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs dark:border-slate-800 dark:bg-slate-900">
                    <div
                        class="border-b border-slate-200 bg-white px-5 py-5 dark:border-slate-800 dark:bg-slate-900 sm:px-7">
                        <div class="flex flex-wrap items-start justify-between gap-4">
                            <div>
                                <p
                                    class="text-xs font-bold uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">
                                    Inventario de endpoints
                                </p>
                                <h2 id="route-list-title" class="mt-1 text-xl font-bold text-slate-950 dark:text-white">
                                    {{ lastOption.name|default('Rutas') }}
                                </h2>
                                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                                    Abre una ruta para consultar su implementación y parámetros.
                                </p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span
                                    class="rounded-lg bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                    {{ routesFromRouteFile|length }} rutas
                                </span>
                                <span
                                    class="rounded-lg bg-teal-50 px-3 py-2 text-xs font-bold text-teal-800 dark:bg-teal-950 dark:text-teal-200">
                                    Jerarquía de grupos
                                </span>
                            </div>
                        </div>
                        <div class="mt-5 grid gap-3 sm:grid-cols-[minmax(0,1fr)_180px_auto]">
                            <label class="relative block">
                                <span class="sr-only">Buscar rutas</span>
                                <span
                                    aria-hidden="true"
                                    class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                                    ⌕
                                </span>
                                <input
                                    type="search"
                                    id="searchInput"
                                    class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 pl-10 pr-3 text-sm text-slate-900 outline-hidden transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-teal-400"
                                    placeholder="Buscar ruta, grupo o controlador…" />
                            </label>
                            <label>
                                <span class="sr-only">Filtrar por método HTTP</span>
                                <select
                                    id="methodFilter"
                                    class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-700 outline-hidden transition focus:border-teal-600 focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:focus:border-teal-400">
                                    <option value="">
                                        Todos los métodos
                                    </option>
                                    <option value="GET">
                                        GET
                                    </option>
                                    <option value="POST">
                                        POST
                                    </option>
                                    <option value="PUT">
                                        PUT
                                    </option>
                                    <option value="PATCH">
                                        PATCH
                                    </option>
                                    <option value="DELETE">
                                        DELETE
                                    </option>
                                </select>
                            </label>
                            <button
                                type="button"
                                id="filterRoutesButton"
                                class="rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-teal-800 focus:outline-hidden focus:ring-2 focus:ring-teal-600 focus:ring-offset-2 dark:bg-teal-700 dark:hover:bg-teal-600">
                                Filtrar
                            </button>
                        </div>
                        <p
                            id="routeResultCount"
                            aria-live="polite"
                            class="mt-3 text-xs text-slate-500 dark:text-slate-400">
                            {{ routesFromRouteFile|length }} resultados
                        </p>
                    </div>

                    <div id="routesList" class="space-y-4 bg-slate-100/70 p-4 dark:bg-gray-950/70 sm:p-6">
                        {% for route in routesFromRouteFile %}
                            {% if route.showGroupHeading %}
                                <div
                                    class="doc-group doc-enter overflow-hidden rounded-xl border border-teal-800/70 px-4 py-4 shadow-md shadow-slate-900/10 dark:border-teal-900 sm:px-5"
                                    data-group-key="{{ route.groupKey|e('html_attr') }}">
                                    <div
                                        class="mb-3 flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.18em] text-teal-300">
                                        <span
                                            class="flex h-6 w-6 items-center justify-center rounded-md bg-teal-300/15">
                                            ⌘
                                        </span>
                                        Grupo de rutas
                                        <span class="h-px flex-1 bg-teal-200/20"></span>
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {% for group in route.groups %}
                                            <div
                                                class="flex min-w-0 items-center gap-2 rounded-lg border border-white/10 bg-black/15 px-3 py-2 {{
                                                not loop.first
                                                    ? 'ml-3 sm:ml-5'
                                                    : ''
                                                }}">
                                                <span
                                                    class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                                                    {{ loop.index == 1 ? 'Prefijo' : 'Anidado' }}
                                                </span>
                                                <code class="doc-code break-all text-xs font-bold text-white">
                                                    {{ group.path }}
                                                </code>
                                                {% if group.description %}
                                                    <span class="hidden text-xs text-slate-300 lg:inline">
                                                        {{ group.description }}
                                                    </span>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                            <article
                                class="doc-route route-item doc-enter overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xs dark:border-slate-800 dark:bg-slate-900"
                                data-method="{{ route.method|upper }}"
                                data-route-template="{{ route.url|e('html_attr') }}"
                                data-group-key="{{ route.groupKey|e('html_attr') }}"
                                data-search="{{ (route.url ~ ' ' ~ route.route ~ ' ' ~ route.description ~ ' ' ~ route.class ~ ' '
                                    ~ route.class_method
                                    ~ ' '
                                    ~ route.groupKey)
                                    |lower
                                    |e('html_attr') }}">
                                <button
                                    type="button"
                                    class="route-toggle flex w-full items-center gap-3 px-4 py-4 text-left sm:gap-5 sm:px-5"
                                    aria-expanded="false">
                                    <span
                                        data-method="{{ route.method|upper }}"
                                        class="route-method inline-flex min-w-[72px] justify-center rounded-lg px-3 py-1.5 text-[11px] font-black tracking-wide text-white {{
                                        route.method == 'GET'
                                            ? 'bg-emerald-600'
                                            : route.method == 'POST'
                                                ? 'bg-sky-700'
                                                : route.method == 'PUT'
                                                    ? 'bg-amber-600'
                                                    : route.method == 'PATCH'
                                                        ? 'bg-violet-700'
                                                        : route.method == 'DELETE' ? 'bg-rose-700' : 'bg-slate-600'
                                        }}">
                                        {{ route.method|upper }}
                                    </span>
                                    <code
                                        class="doc-code min-w-0 flex-1 break-all text-xs font-semibold text-slate-800 dark:text-slate-200 sm:text-sm">
                                        {{ route.url }}
                                    </code>
                                    {% if route.csrf == 'protected' %}
                                        <span
                                            title="El Router valida el token CSRF en esta ruta"
                                            class="hidden rounded-md bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300 sm:inline">
                                            CSRF
                                        </span>
                                    {% elseif route.csrf == 'exempt' %}
                                        <span
                                            title="Ruta marcada con withoutCsrf(): no valida el token CSRF"
                                            class="rounded-md bg-rose-100 px-2 py-1 text-[10px] font-bold text-rose-800 dark:bg-rose-950 dark:text-rose-200">
                                            SIN CSRF
                                        </span>
                                    {% endif %}
                                    {% if (route.issues|length) > 0 %}
                                        <span
                                            class="rounded-md bg-amber-100 px-2 py-1 text-[10px] font-bold text-amber-900 dark:bg-amber-950 dark:text-amber-200">
                                            {{ route.issues|length }} {{ (route.issues|length) == 1 ? 'aviso' : 'avisos' }}
                                        </span>
                                    {% endif %}
                                    <span
                                        class="hidden flex-[1.2] text-sm leading-5 text-slate-600 dark:text-slate-400 md:block">
                                        {{ route.description|capitalize }}
                                    </span>
                                    <span aria-hidden="true" class="route-chevron text-slate-400 transition-transform">
                                        ⌄
                                    </span>
                                </button>
                                <p class="px-4 pb-3 text-sm leading-5 text-slate-600 dark:text-slate-400 md:hidden">
                                    {{ route.description|capitalize }}
                                </p>
                                {% if (route.issues|length) > 0 or route.url != route.route %}
                                    <ul class="space-y-1 px-4 pb-3 text-xs sm:px-5">
                                        {% if route.url != route.route %}
                                            <li class="text-slate-500 dark:text-slate-400">
                                                Declarada como <code class="doc-code">{{ route.route }}</code>; el
                                                panel se sirve bajo <code class="doc-code">/{{ config.admin.custom_url }}</code>.
                                            </li>
                                        {% endif %}
                                        {% for issue in route.issues %}
                                            <li
                                                class="{{ issue.level == 'error'
                                                    ? 'font-semibold text-rose-700 dark:text-rose-300'
                                                    : 'text-amber-800 dark:text-amber-300' }}">
                                                {{ issue.level == 'error' ? 'Error' : 'Aviso' }}: {{ issue.message }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                                <div
                                    class="route-details hidden border-t border-slate-200 bg-slate-50 px-4 py-5 dark:border-slate-800 dark:bg-slate-950 sm:px-5">
                                    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
                                        <div class="space-y-2">
                                            <div class="flex flex-wrap gap-x-2 text-sm">
                                                <span class="font-bold text-slate-500 dark:text-slate-400">
                                                    Controlador
                                                </span>
                                                <code class="doc-code text-slate-800 dark:text-slate-200">
                                                    {{ route.class }}
                                                </code>
                                            </div>
                                            <div class="flex flex-wrap gap-x-2 text-sm">
                                                <span class="font-bold text-slate-500 dark:text-slate-400">Acción</span>
                                                <code class="doc-code text-teal-800 dark:text-teal-300">
                                                    {{ route.class_method|trim }}
                                                </code>
                                            </div>
                                            {% if (route.middleware|length) > 0 %}
                                                <div class="pt-3">
                                                    <h3
                                                        class="mb-2 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                        Middleware
                                                    </h3>
                                                    <div class="flex flex-wrap gap-2">
                                                        {% for middleware in route.middleware %}
                                                            <span
                                                                class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
                                                                <code class="doc-code">
                                                                    {{
                                                                        middleware.class|replace({
                                                                            '::class': ''
                                                                        })
                                                                    }}
                                                                </code><span class="text-slate-400">
                                                                    · {{ middleware.class_method }}
                                                                </span>
                                                            </span>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="grid gap-4 sm:grid-cols-2">
                                            {% if (route.pathParams|length) > 0 %}
                                                <div>
                                                    <h3
                                                        class="mb-2 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                        Parámetros de ruta
                                                    </h3>
                                                    {% for param in route.pathParams %}
                                                        <div
                                                            class="mb-2 rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-900">
                                                            <code
                                                                class="doc-code text-xs font-bold text-teal-800 dark:text-teal-300">
                                                                {{ param.name }}
                                                            </code><span class="ml-1 text-xs text-slate-600 dark:text-slate-300">
                                                                {{ param.type }}
                                                            </span>
                                                            <p
                                                                class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">
                                                                {{ param.description }}
                                                            </p>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                            {% if (route.queryParams|length) > 0 %}
                                                <div>
                                                    <h3
                                                        class="mb-2 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                        Parámetros de consulta
                                                    </h3>
                                                    {% for param in route.queryParams %}
                                                        <div
                                                            class="mb-2 rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-900">
                                                            <code
                                                                class="doc-code text-xs font-bold text-sky-800 dark:text-sky-300">
                                                                {{ param.name }}
                                                            </code><span class="ml-1 text-xs text-slate-600 dark:text-slate-300">
                                                                {{ param.type }}
                                                            </span>
                                                            <p
                                                                class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">
                                                                {{ param.description }}
                                                            </p>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                            {% if (route.requestBody|length) > 0 %}
                                                <div class="sm:col-span-2">
                                                    <h3
                                                        class="mb-2 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                        Cuerpo de la solicitud
                                                    </h3>
                                                    <div class="grid gap-2 sm:grid-cols-2">
                                                        {% for param in route.requestBody %}
                                                            <div
                                                                class="rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-900">
                                                                <code
                                                                    class="doc-code text-xs font-bold text-amber-800 dark:text-amber-300">
                                                                    {{ param.name }}
                                                                </code><span class="ml-1 text-xs text-slate-600 dark:text-slate-300">
                                                                    {{ param.type }}
                                                                </span>
                                                                <p
                                                                    class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">
                                                                    {{ param.description }}
                                                                </p>
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    {# El probador se construye al abrir la tarjeta, a partir de la plantilla #route-tester-template #}
                                    <div
                                        class="route-tester mt-6 border-t border-slate-200 pt-5 dark:border-slate-800"
                                        data-route="{{ {
                                            method: route.method|upper,
                                            url: route.url,
                                            pathParams: route.routeParams,
                                            queryParams: route.queryParams,
                                            requestBody: route.requestBody
                                        }|json_encode|e('html_attr') }}"></div>
                                </div>
                            </article>
                        {% endfor %}
                        <p
                            id="emptyRoutesMessage"
                            class="hidden rounded-xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                            No hay rutas que coincidan con estos filtros.
                        </p>
                    </div>
                </section>
            {% endif %}
        </div>
    </div>
    <template id="route-tester-template">
        <div class="space-y-4">
            {# Barra de petición #}
            <div class="flex flex-wrap items-stretch gap-2">
                <div
                    class="flex min-w-0 flex-1 items-center gap-3 rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-950">
                    <span class="rt-method doc-code text-xs font-black"></span>
                    <code class="rt-url doc-code min-w-0 flex-1 truncate text-xs text-slate-800 dark:text-slate-200"></code>
                </div>
                <button
                    type="button"
                    class="rt-curl rounded-lg border border-slate-300 px-3 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
                    Copiar cURL
                </button>
                <button
                    type="button"
                    title="Ctrl + Enter"
                    class="rt-send inline-flex items-center gap-2 rounded-lg bg-teal-700 px-5 py-2 text-xs font-bold text-white transition hover:bg-teal-600 focus:outline-hidden focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60 dark:focus:ring-offset-slate-900">
                    Enviar
                </button>
            </div>

            {# Pestañas de la petición #}
            <div>
                <div class="flex gap-1 border-b border-slate-200 dark:border-slate-700" role="tablist">
                    <button type="button" class="rt-tab" data-group="request" data-tab="params">
                        Parámetros <span class="rt-count" data-count="params"></span>
                    </button>
                    <button type="button" class="rt-tab" data-group="request" data-tab="body">Cuerpo</button>
                    <button type="button" class="rt-tab" data-group="request" data-tab="headers">Encabezados</button>
                </div>
                <div class="rt-pane pt-3" data-group="request" data-pane="params">
                    <div class="rt-params grid gap-x-4 gap-y-3 sm:grid-cols-2"></div>
                    <p class="rt-no-params hidden text-xs text-slate-500 dark:text-slate-400">
                        Esta ruta no declara parámetros de ruta ni de consulta.
                    </p>
                </div>
                <div class="rt-pane hidden pt-3" data-group="request" data-pane="body">
                    <div class="rt-body-wrap">
                        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">JSON</span>
                            <span class="flex gap-2">
                                <button type="button" class="rt-example rt-link">Usar ejemplo</button>
                                <button type="button" class="rt-format rt-link">Formatear</button>
                            </span>
                        </div>
                        <textarea
                            class="rt-body doc-code min-h-32 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs leading-5 text-slate-900 outline-hidden focus:border-teal-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                            spellcheck="false"></textarea>
                        <p class="rt-body-error mt-1 hidden text-xs font-semibold text-rose-700 dark:text-rose-300"></p>
                        <div class="rt-files mt-3 space-y-3"></div>
                    </div>
                    <p class="rt-no-body hidden text-xs text-slate-500 dark:text-slate-400">
                        Las peticiones GET no llevan cuerpo.
                    </p>
                </div>
                <div class="rt-pane hidden pt-3" data-group="request" data-pane="headers">
                    <textarea
                        class="rt-headers doc-code min-h-20 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs leading-5 text-slate-900 outline-hidden focus:border-teal-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
                        placeholder="X-Mi-Encabezado: valor"
                        spellcheck="false"></textarea>
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                        Uno por línea. Se envían siempre <code class="doc-code">Accept</code>,
                        <code class="doc-code">X-Requested-With</code> y <code class="doc-code">X-CSRF-Token</code>, además
                        de tu sesión.
                    </p>
                </div>
            </div>

            {# Respuesta #}
            <div
                class="rt-response hidden overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900"
                aria-live="polite">
                <div
                    class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-slate-200 px-3 py-2.5 dark:border-slate-700">
                    <span class="rt-status rounded-md px-2 py-1 text-xs font-black"></span>
                    <span class="rt-meta text-xs text-slate-600 dark:text-slate-300"></span>
                    <span class="rt-note text-xs text-amber-700 dark:text-amber-300"></span>
                    <button type="button" class="rt-copy rt-link ml-auto">Copiar respuesta</button>
                </div>
                <div class="flex gap-1 border-b border-slate-200 px-2 dark:border-slate-700" role="tablist">
                    <button type="button" class="rt-tab" data-group="response" data-tab="preview">Vista previa</button>
                    <button type="button" class="rt-tab" data-group="response" data-tab="json">JSON</button>
                    <button type="button" class="rt-tab" data-group="response" data-tab="raw">Raw</button>
                    <button type="button" class="rt-tab" data-group="response" data-tab="headers">
                        Encabezados <span class="rt-count" data-count="headers"></span>
                    </button>
                </div>
                <div class="rt-pane hidden" data-group="response" data-pane="preview"></div>
                <div
                    class="rt-pane rt-json doc-code hidden max-h-128 overflow-auto p-3 text-xs leading-5"
                    data-group="response"
                    data-pane="json"></div>
                <pre
                    class="rt-pane rt-raw doc-code hidden max-h-128 overflow-auto whitespace-pre-wrap wrap-break-word p-3 text-xs leading-5 text-slate-800 dark:text-slate-200"
                    data-group="response"
                    data-pane="raw"></pre>
                <div class="rt-pane hidden max-h-128 overflow-auto" data-group="response" data-pane="headers">
                    <table class="w-full text-left text-xs">
                        <tbody class="rt-headers-out"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </template>
{% endblock %}
{% block appScript %}
    {# El script va en verbatim: es JavaScript plano, sin expresiones de Twig #}
    <!-- prettier-ignore -->
    <script nonce="{{ csp_nonce() }}">
{% verbatim %}
        (() => {
            const routesList = document.getElementById('routesList');
            const searchInput = document.getElementById('searchInput');
            const methodFilter = document.getElementById('methodFilter');
            const filterButton = document.getElementById('filterRoutesButton');
            const resultCount = document.getElementById('routeResultCount');
            const emptyMessage = document.getElementById('emptyRoutesMessage');
            const testerTemplate = document.getElementById('route-tester-template');

            const MAX_RESPONSE_BYTES = 1024 * 1024;
            const MAX_JSON_CHILDREN = 200;
            const MAX_JSON_STRING = 300;
            const STATUS_TEXT = {
                200: 'OK', 201: 'Created', 204: 'No Content', 301: 'Moved Permanently', 302: 'Found', 304: 'Not Modified',
                400: 'Bad Request', 401: 'Unauthorized', 403: 'Forbidden', 404: 'Not Found', 405: 'Method Not Allowed',
                419: 'Session Expired', 422: 'Unprocessable Content', 429: 'Too Many Requests',
                500: 'Internal Server Error', 502: 'Bad Gateway', 503: 'Service Unavailable',
            };
            const METHOD_COLORS = {
                GET: 'text-emerald-700 dark:text-emerald-300',
                POST: 'text-sky-700 dark:text-sky-300',
                PUT: 'text-amber-700 dark:text-amber-300',
                PATCH: 'text-violet-700 dark:text-violet-300',
                DELETE: 'text-rose-700 dark:text-rose-300',
            };
            const INPUT_CLASS =
                'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-normal text-slate-900 ' +
                'outline-hidden focus:border-teal-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100';

            const el = (tag, className, text) => {
                const node = document.createElement(tag);
                if (className) node.className = className;
                if (text !== undefined) node.textContent = text;
                return node;
            };

            const formatBytes = bytes => {
                if (bytes < 1024) return bytes + ' B';
                if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
                return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
            };

            // ------------------------------------------------------------------
            // Pestañas: los botones [data-tab] muestran el panel [data-pane] de su mismo grupo
            // ------------------------------------------------------------------
            function selectTab(root, group, name) {
                root.querySelectorAll(`.rt-tab[data-group="${group}"]`).forEach(tab => {
                    tab.setAttribute('aria-selected', String(tab.dataset.tab === name));
                });
                root.querySelectorAll(`.rt-pane[data-group="${group}"]`).forEach(pane => {
                    pane.classList.toggle('hidden', pane.dataset.pane !== name);
                });
            }

            function setTabVisible(root, group, name, visible) {
                root.querySelector(`.rt-tab[data-group="${group}"][data-tab="${name}"]`)?.classList.toggle('hidden', !visible);
            }

            // ------------------------------------------------------------------
            // Construcción del probador (una vez por tarjeta, al abrirla)
            // ------------------------------------------------------------------
            function exampleValue(type) {
                const t = String(type || '').toLowerCase();
                if (/int|float|number|decimal|numeric/.test(t)) return 0;
                if (/bool/.test(t)) return false;
                if (/array|\[\]/.test(t)) return [];
                if (/object|json/.test(t)) return {};
                return '';
            }

            function paramField(label, hint, attribute, name, required) {
                const wrapper = el('label', 'block text-xs font-semibold text-slate-700 dark:text-slate-300');
                wrapper.append(label);
                if (required) wrapper.append(el('span', 'ml-1 font-bold text-rose-600 dark:text-rose-400', '*'));
                const input = el('input', INPUT_CLASS);
                input.type = 'text';
                input.placeholder = hint || '';
                input.required = required;
                input.setAttribute(attribute, name);
                wrapper.append(input);
                return wrapper;
            }

            function buildTester(container) {
                if (container.dataset.ready || !(testerTemplate instanceof HTMLTemplateElement)) return;
                container.dataset.ready = '1';

                const route = JSON.parse(container.dataset.route || '{}');
                container.append(testerTemplate.content.cloneNode(true));
                container.routeData = route;

                const method = container.querySelector('.rt-method');
                method.textContent = route.method;
                method.className += ' ' + (METHOD_COLORS[route.method] || '');

                // Parámetros de ruta y de consulta
                const params = container.querySelector('.rt-params');
                const documented = Object.fromEntries((route.pathParams || []).map(name => [name, '']));
                (route.pathParams || []).forEach(name => {
                    params.append(paramField(name, 'Parámetro de ruta', 'data-path-param', name, true));
                });
                (route.queryParams || []).forEach(param => {
                    if (param.name in documented) return;
                    params.append(paramField(param.name, param.description, 'data-query-param', param.name, false));
                });
                const paramCount = params.children.length;
                container.querySelector('[data-count="params"]').textContent = paramCount ? `(${paramCount})` : '';
                container.querySelector('.rt-no-params').classList.toggle('hidden', paramCount > 0);

                // Cuerpo: ejemplo generado desde las anotaciones request-body
                const hasBody = !['GET', 'HEAD'].includes(route.method);
                container.querySelector('.rt-body-wrap').classList.toggle('hidden', !hasBody);
                container.querySelector('.rt-no-body').classList.toggle('hidden', hasBody);

                const example = {};
                const files = container.querySelector('.rt-files');
                (route.requestBody || []).forEach(param => {
                    if (String(param.type).includes('file')) {
                        const wrapper = el('label', 'block text-xs font-semibold text-slate-700 dark:text-slate-300', param.name);
                        wrapper.append(el('span', 'font-normal text-slate-500 dark:text-slate-400', ' · ' + param.description));
                        const input = el(
                            'input',
                            'mt-1.5 block w-full rounded-lg border border-slate-300 bg-white text-xs text-slate-700 ' +
                                'file:mr-3 file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-xs file:font-bold ' +
                                'dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:file:bg-slate-800 dark:file:text-slate-200',
                        );
                        input.type = 'file';
                        input.multiple = param.type === 'file[]';
                        input.dataset.fileParam = param.name;
                        wrapper.append(input);
                        files.append(wrapper);
                    } else {
                        example[param.name] = exampleValue(param.type);
                    }
                });
                const exampleText = JSON.stringify(example, null, 2);
                const body = container.querySelector('.rt-body');
                body.placeholder = Object.keys(example).length ? exampleText : '{\n  "campo": "valor"\n}';
                container.querySelector('.rt-example').classList.toggle('hidden', Object.keys(example).length === 0);
                container.querySelector('.rt-example').addEventListener('click', () => {
                    body.value = exampleText;
                    body.focus();
                });

                selectTab(container, 'request', paramCount === 0 && hasBody ? 'body' : 'params');
                updateUrl(container);
            }

            // ------------------------------------------------------------------
            // Petición
            // ------------------------------------------------------------------
            /** Devuelve la URL final, o null si falta un parámetro de ruta (y enfoca el campo si se pide). */
            function buildUrl(container, focusMissing) {
                let path = container.routeData.url || '';
                for (const input of container.querySelectorAll('[data-path-param]')) {
                    const value = input.value.trim();
                    if (!value) {
                        if (focusMissing) {
                            selectTab(container, 'request', 'params');
                            input.focus();
                            input.reportValidity();
                        }
                        return null;
                    }
                    path = path.replace('{' + input.dataset.pathParam + '}', encodeURIComponent(value));
                }

                const url = new URL(path, window.location.origin);
                for (const input of container.querySelectorAll('[data-query-param]')) {
                    const value = input.value.trim();
                    if (value) url.searchParams.set(input.dataset.queryParam, value);
                }
                return url;
            }

            function updateUrl(container) {
                const url = buildUrl(container, false);
                const display = container.querySelector('.rt-url');
                display.textContent = url ? url.pathname + url.search : container.routeData.url;
                display.title = display.textContent;
            }

            function parseHeaders(container) {
                const headers = {};
                container
                    .querySelector('.rt-headers')
                    .value.split('\n')
                    .forEach(line => {
                        const separator = line.indexOf(':');
                        if (separator > 0) headers[line.slice(0, separator).trim()] = line.slice(separator + 1).trim();
                    });
                return headers;
            }

            /** Lee y valida el cuerpo JSON. Devuelve { ok, text, data } o muestra el error en el propio campo. */
            function readBody(container) {
                const input = container.querySelector('.rt-body');
                const error = container.querySelector('.rt-body-error');
                const text = input.value.trim();
                error.classList.add('hidden');
                if (!text) return { ok: true, text: '', data: {} };

                try {
                    const data = JSON.parse(text);
                    if (!data || typeof data !== 'object' || Array.isArray(data)) {
                        throw new Error('El cuerpo debe ser un objeto JSON.');
                    }
                    return { ok: true, text, data };
                } catch (exception) {
                    error.textContent = 'JSON inválido: ' + (exception instanceof Error ? exception.message : 'revisa el formato');
                    error.classList.remove('hidden');
                    selectTab(container, 'request', 'body');
                    input.focus();
                    return { ok: false };
                }
            }

            function buildRequest(container, confirmMutation) {
                const route = container.routeData;
                const url = buildUrl(container, true);
                if (!url) return null;

                const headers = new Headers({
                    Accept: 'application/json, text/plain, */*',
                    'X-Requested-With': 'XMLHttpRequest',
                });
                const csrfToken = document.querySelector('#csrf_token')?.value;
                if (csrfToken) headers.set('X-CSRF-Token', csrfToken);
                for (const [name, value] of Object.entries(parseHeaders(container))) {
                    try {
                        headers.set(name, value);
                    } catch {
                        /* nombre de encabezado inválido: se ignora */
                    }
                }

                const request = { method: route.method, credentials: 'same-origin', headers };
                let curlBody = '';

                if (!['GET', 'HEAD'].includes(route.method)) {
                    const body = readBody(container);
                    if (!body.ok) return null;

                    const fileInputs = [...container.querySelectorAll('[data-file-param]')].filter(input => input.files.length);
                    if (fileInputs.length) {
                        const form = new FormData();
                        for (const [key, value] of Object.entries(body.data)) {
                            form.append(key, value !== null && typeof value === 'object' ? JSON.stringify(value) : String(value));
                            curlBody += ` \\\n  -F ${shellQuote(key + '=' + String(value))}`;
                        }
                        for (const input of fileInputs) {
                            for (const file of input.files) {
                                form.append(input.dataset.fileParam, file);
                                curlBody += ` \\\n  -F ${shellQuote(input.dataset.fileParam + '=@' + file.name)}`;
                            }
                        }
                        request.body = form;
                    } else if (body.text) {
                        headers.set('Content-Type', 'application/json');
                        request.body = JSON.stringify(body.data);
                        curlBody = ` \\\n  --data ${shellQuote(request.body)}`;
                    }

                    if (
                        confirmMutation &&
                        !window.confirm(
                            `Vas a enviar ${route.method} ${url.pathname}${url.search}.\n` +
                                'Puede modificar datos reales y no se deshace automáticamente. ¿Continuar?',
                        )
                    ) {
                        return null;
                    }
                }

                return { url, request, headers, curlBody };
            }

            const shellQuote = value => "'" + String(value).replaceAll("'", "'\\''") + "'";

            function copyCurl(container, button) {
                const built = buildRequest(container, false);
                if (!built) return;

                let command = `curl -X ${container.routeData.method} ${shellQuote(built.url.href)}`;
                built.headers.forEach((value, name) => {
                    command += ` \\\n  -H ${shellQuote(name + ': ' + value)}`;
                });
                // Sin cookies: las de sesión son HttpOnly y no deben copiarse al portapapeles
                command += built.curlBody;
                copyText(command, button);
            }

            function copyText(text, button) {
                const original = button.textContent;
                const done = message => {
                    button.textContent = message;
                    setTimeout(() => (button.textContent = original), 1400);
                };
                navigator.clipboard.writeText(text).then(
                    () => done('Copiado'),
                    () => done('No se pudo copiar'),
                );
            }

            // ------------------------------------------------------------------
            // Respuesta
            // ------------------------------------------------------------------
            async function readText(response) {
                if (!response.body) return { text: '', bytes: 0, truncated: false };

                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let text = '';
                let bytes = 0;
                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    bytes += value.byteLength;
                    if (bytes > MAX_RESPONSE_BYTES) {
                        text += decoder.decode(value.subarray(0, value.byteLength - (bytes - MAX_RESPONSE_BYTES)), { stream: true });
                        await reader.cancel();
                        return { text, bytes, truncated: true };
                    }
                    text += decoder.decode(value, { stream: true });
                }
                return { text: text + decoder.decode(), bytes, truncated: false };
            }

            /** Árbol JSON plegable con <details>; los nodos se crean como texto, nunca como HTML. */
            function jsonNode(key, value, depth) {
                const label = () => (key === null ? '' : JSON.stringify(key));
                const keyPart = parent => {
                    if (key === null) return;
                    parent.append(el('span', 'k', label()), ': ');
                };

                if (value !== null && typeof value === 'object') {
                    const isArray = Array.isArray(value);
                    const entries = isArray ? value.map((item, index) => [index, item]) : Object.entries(value);
                    const details = el('details');
                    details.open = depth < 2;
                    const summary = el('summary');
                    keyPart(summary);
                    summary.append(
                        isArray ? '[' : '{',
                        el('span', 'z', ` ${entries.length} ${isArray ? 'elementos' : 'claves'} `),
                        isArray ? ']' : '}',
                    );
                    details.append(summary);

                    const children = el('div', 'rt-children');
                    entries.slice(0, MAX_JSON_CHILDREN).forEach(([childKey, childValue]) => {
                        children.append(jsonNode(isArray ? null : childKey, childValue, depth + 1));
                    });
                    if (entries.length > MAX_JSON_CHILDREN) {
                        children.append(el('div', 'rt-leaf z', `… ${entries.length - MAX_JSON_CHILDREN} más (ver en Raw)`));
                    }
                    details.append(children);
                    return details;
                }

                // Los textos muy largos (HTML, tokens, base64) se muestran plegados
                if (typeof value === 'string' && value.length > MAX_JSON_STRING) {
                    const details = el('details');
                    const summary = el('summary');
                    keyPart(summary);
                    summary.append(
                        el('span', 's', JSON.stringify(value.slice(0, 80)).slice(0, -1) + '…"'),
                        el('span', 'z', ` ${value.length.toLocaleString('es')} caracteres`),
                    );
                    details.append(summary, el('div', 'rt-children s break-all', JSON.stringify(value)));
                    return details;
                }

                const leaf = el('div', 'rt-leaf');
                keyPart(leaf);
                const type = value === null ? 'z' : typeof value === 'string' ? 's' : typeof value === 'number' ? 'n' : 'b';
                leaf.append(el('span', type + ' break-all', typeof value === 'string' ? JSON.stringify(value) : String(value)));
                return leaf;
            }

            /** HTML renderizado en un iframe aislado: sin scripts ni acceso a la sesión de esta página. */
            function htmlPreview(html) {
                const styles = [...document.querySelectorAll('link[rel="stylesheet"]')]
                    .map(link => `<link rel="stylesheet" href="${link.href}">`)
                    .join('');
                const dark = document.documentElement.classList.contains('dark');
                const frame = el('iframe', 'h-128 w-full border-0 bg-white dark:bg-black');
                frame.setAttribute('sandbox', '');
                frame.setAttribute('title', 'Vista previa de la respuesta');
                // Sin etiquetas html, head ni body escritas aquí: el proxy de desarrollo (versacompiler /
                // BrowserSync) inserta su script en el primer cierre de body que encuentra en la página,
                // aunque esté dentro de un texto de JavaScript, y eso corta este script.
                // El navegador crea esas etiquetas solo; el tema oscuro lo activa el contenedor .dark.
                frame.srcdoc =
                    `<meta charset="utf-8"><base href="${window.location.origin}/" target="_blank">${styles}` +
                    `<div class="${dark ? 'dark' : ''}"><div class="min-h-screen p-4 ` +
                    `${dark ? 'bg-black text-gray-100' : 'bg-white text-gray-900'}">${html}</div></div>`;
                return frame;
            }

            function showResponse(container, { status, statusText, headers, text, bytes, truncated, elapsed, redirectedTo, image }) {
                const panel = container.querySelector('.rt-response');
                panel.classList.remove('hidden');

                const statusBadge = container.querySelector('.rt-status');
                const tone =
                    status >= 500
                        ? 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200'
                        : status >= 400
                          ? 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200'
                          : status >= 300
                            ? 'bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-200'
                            : status >= 200
                              ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200'
                              : 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200';
                statusBadge.className = 'rt-status rounded-md px-2 py-1 text-xs font-black ' + tone;
                // El servidor de desarrollo de PHP no conoce todos los códigos: se usa un nombre propio
        const reason = STATUS_TEXT[status] || (/unknown/i.test(statusText) ? '' : statusText);
            statusBadge.textContent = status ? `${status} ${reason}`.trim() : statusText;
                container.querySelector('.rt-meta').textContent = `${elapsed} ms · ${formatBytes(bytes)}`;

                // Encabezados
                const headerRows = container.querySelector('.rt-headers-out');
                headerRows.replaceChildren();
                headers.forEach(([name, value]) => {
                    const row = el('tr', 'border-b border-slate-100 last:border-0 dark:border-slate-800');
                    row.append(
                        el('td', 'doc-code whitespace-nowrap px-3 py-1.5 align-top font-bold text-slate-700 dark:text-slate-200', name),
                        el('td', 'doc-code break-all px-3 py-1.5 text-slate-700 dark:text-slate-300', value),
                    );
                    headerRows.append(row);
                });
                container.querySelector('[data-count="headers"]').textContent = headers.length ? `(${headers.length})` : '';

                // Cuerpo: se detecta qué es para elegir cómo mostrarlo
                const contentType = (headers.find(([name]) => name.toLowerCase() === 'content-type')?.[1] || '').toLowerCase();
                let json;
                let isJson = false;
                if (!truncated && text && (contentType.includes('json') || /^\s*[[{]/.test(text))) {
                    try {
                        json = JSON.parse(text);
                        isJson = true;
                    } catch {
                        /* no es JSON válido: se muestra como texto */
                    }
                }

                const isVuePage = isJson && json && json.type === 'vue' && typeof json.module === 'string';
                const notes = [];
                if (redirectedTo) notes.push('Redirigida a ' + redirectedTo);
                if (truncated) notes.push('Respuesta truncada a 1 MB');
                if (isVuePage) notes.push('Página Vue: el contenido lo dibuja el módulo ' + json.module);
                container.querySelector('.rt-note').textContent = notes.join(' · ');

                container.querySelector('.rt-raw').textContent = text || '(Respuesta sin contenido)';
                container.lastResponseText = text;

                const jsonPane = container.querySelector('.rt-json');
                jsonPane.replaceChildren();
                if (isJson) jsonPane.append(jsonNode(null, json, 0));

                // Vista previa: HTML de una respuesta SPA ({ type: "html", content }), HTML directo o imagen
                const previewPane = container.querySelector('.rt-pane[data-pane="preview"]');
                previewPane.replaceChildren();
                let preview = null;
                if (image) {
                    const picture = el('img', 'mx-auto max-h-128 p-3');
                    picture.src = image;
                    picture.alt = 'Imagen de la respuesta';
                    preview = picture;
                } else if (isJson && json && json.type === 'html' && typeof json.content === 'string') {
                    preview = htmlPreview(json.content);
                    const scripts = Array.isArray(json.scripts) ? json.scripts.length : 0;
                    previewPane.append(
                        el(
                            'p',
                            'border-b border-slate-200 px-3 py-2 text-xs text-slate-600 dark:border-slate-700 dark:text-slate-300',
                            'Respuesta de navegación SPA (type: "html"): se muestra el campo content.' +
                                (scripts ? ` Sus ${scripts} scripts no se ejecutan en la vista previa.` : ''),
                        ),
                    );
                } else if (!isJson && contentType.includes('html') && text) {
                    preview = htmlPreview(text);
                }
                if (preview) previewPane.append(preview);

                setTabVisible(container, 'response', 'preview', Boolean(preview));
                setTabVisible(container, 'response', 'json', isJson);
                selectTab(container, 'response', preview ? 'preview' : isJson ? 'json' : 'raw');
            }

            async function send(container) {
                const built = buildRequest(container, true);
                if (!built) return;

                const button = container.querySelector('.rt-send');
                const started = performance.now();
                button.disabled = true;
                button.textContent = 'Enviando…';

                try {
                    const response = await fetch(built.url, built.request);
                    const contentType = response.headers.get('content-type') || '';
                    const base = {
                        status: response.status,
                        statusText: response.statusText,
                        headers: [...response.headers.entries()],
                        redirectedTo: response.redirected ? new URL(response.url).pathname : '',
                    };

                    if (contentType.startsWith('image/')) {
                        const blob = await response.blob();
                        showResponse(container, {
                            ...base,
                            text: `[Imagen ${contentType}]`,
                            bytes: blob.size,
                            truncated: false,
                            image: URL.createObjectURL(blob),
                            elapsed: Math.round(performance.now() - started),
                        });
                    } else if (contentType && !/json|text|xml|javascript|x-www-form-urlencoded/i.test(contentType)) {
                        const blob = await response.blob();
                        showResponse(container, {
                            ...base,
                            text: `[Contenido binario (${contentType}): no se muestra]`,
                            bytes: blob.size,
                            truncated: false,
                            elapsed: Math.round(performance.now() - started),
                        });
                    } else {
                        const body = await readText(response);
                        showResponse(container, { ...base, ...body, elapsed: Math.round(performance.now() - started) });
                    }
                } catch (exception) {
                    showResponse(container, {
                        status: 0,
                        statusText: 'Error de red',
                        headers: [],
                        text: exception instanceof Error ? exception.message : 'No se pudo completar la petición.',
                        bytes: 0,
                        truncated: false,
                        elapsed: Math.round(performance.now() - started),
                    });
                } finally {
                    button.disabled = false;
                    button.textContent = 'Enviar';
                }
            }

            // ------------------------------------------------------------------
            // Filtro del listado
            // ------------------------------------------------------------------
            function updateRoutes() {
                if (!routesList || !searchInput || !methodFilter) return;

                const term = searchInput.value.trim().toLocaleLowerCase();
                const selectedMethod = methodFilter.value;
                let visibleCount = 0;

                routesList.querySelectorAll('.route-item').forEach(item => {
                    const visible =
                        (item.dataset.search || '').includes(term) && (!selectedMethod || item.dataset.method === selectedMethod);
                    item.classList.toggle('hidden', !visible);
                    if (visible) visibleCount++;
                });

                routesList.querySelectorAll('.doc-group').forEach(group => {
                    let sibling = group.nextElementSibling;
                    let hasVisibleRoute = false;
                    while (sibling && !sibling.classList.contains('doc-group')) {
                        if (
                            sibling.classList.contains('route-item') &&
                            !sibling.classList.contains('hidden') &&
                            sibling.getAttribute('data-group-key') === group.getAttribute('data-group-key')
                        ) {
                            hasVisibleRoute = true;
                            break;
                        }
                        sibling = sibling.nextElementSibling;
                    }
                    group.classList.toggle('hidden', !hasVisibleRoute);
                });

                if (resultCount) resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'resultado' : 'resultados'}`;
                emptyMessage?.classList.toggle('hidden', visibleCount > 0);
            }

            // ------------------------------------------------------------------
            // Eventos (delegados en el listado)
            // ------------------------------------------------------------------
            routesList?.addEventListener('click', event => {
                if (!(event.target instanceof Element)) return;

                const toggle = event.target.closest('.route-toggle');
                if (toggle instanceof HTMLButtonElement) {
                    const details = toggle.parentElement?.querySelector('.route-details');
                    if (!details) return;
                    const expanded = toggle.getAttribute('aria-expanded') === 'true';
                    toggle.setAttribute('aria-expanded', String(!expanded));
                    details.classList.toggle('hidden', expanded);
                    toggle.querySelector('.route-chevron')?.classList.toggle('rotate-180', !expanded);
                    const tester = details.querySelector('.route-tester');
                    if (tester && !expanded) buildTester(tester);
                    return;
                }

                const tester = event.target.closest('.route-tester');
                if (!tester) return;

                const tab = event.target.closest('.rt-tab');
                if (tab) return selectTab(tester, tab.dataset.group, tab.dataset.tab);
                if (event.target.closest('.rt-send')) return void send(tester);
                if (event.target.closest('.rt-curl')) return copyCurl(tester, event.target.closest('.rt-curl'));
                if (event.target.closest('.rt-copy')) return copyText(tester.lastResponseText || '', event.target.closest('.rt-copy'));
                if (event.target.closest('.rt-format')) {
                    const body = readBody(tester);
                    if (body.ok && body.text) tester.querySelector('.rt-body').value = JSON.stringify(body.data, null, 2);
                }
            });

            routesList?.addEventListener('input', event => {
                const tester = event.target instanceof Element ? event.target.closest('.route-tester') : null;
                if (tester && event.target.matches('[data-path-param], [data-query-param]')) updateUrl(tester);
            });

            routesList?.addEventListener('keydown', event => {
                const tester = event.target instanceof Element ? event.target.closest('.route-tester') : null;
                if (tester && event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
                    event.preventDefault();
                    void send(tester);
                }
            });

            searchInput?.addEventListener('input', updateRoutes);
            methodFilter?.addEventListener('change', updateRoutes);
            filterButton?.addEventListener('click', updateRoutes);
            updateRoutes();
        })();
{% endverbatim %}
    </script>
{% endblock %}
