{% extends 'dashboard/layout/layout.twig' %}
{% block appHead %}
    <style>
        .doc-shell { --doc-accent: #19a985; font-family: 'Lato', sans-serif; }

        .doc-code { font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; font-variant-ligatures: none;
        }

        .doc-route { transition: border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease; }

        .doc-route:hover { border-color: rgb(20 184 166 / 42%); box-shadow: 0 10px 26px rgb(15 23 42 / 7%); }

        .doc-group { background: radial-gradient(ellipse at top left, rgb(20 184 166 / 13%), transparent 55%), #10252f;
        }

        .dark .doc-group { background: radial-gradient(ellipse at top left, rgb(20 184 166 / 16%), transparent 55%),
        #0c1b23; }

        .doc-enter { animation: doc-enter 320ms ease-out both; }

        @keyframes doc-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform:
        translateY(0); } }

        @media (prefers-reduced-motion: reduce) { .doc-route, .doc-enter { animation: none; transition: none; } }

        .doc-shell { background-color: #f1f5f9 !important; color: #1e293b !important; color-scheme: light; }

        .doc-shell h1, .doc-shell h2, .doc-shell h3, .doc-shell h4 { color: #0f172a !important; }

        .doc-shell p, .doc-shell nav span, .doc-shell label { color: #475569 !important; }

        .doc-shell header > div p:first-of-type, .doc-shell section > div > div > p:first-child { color: #0f766e
        !important; }

        .doc-shell section { border-color: #cbd5e1 !important; background-color: #ffffff !important; color: #1e293b
        !important; }

        .doc-shell versa-link { border-color: #cbd5e1 !important; background-color: #f8fafc !important; color: #1e293b
        !important; }

        .doc-shell versa-link:hover { border-color: #0f766e !important; background-color: #ffffff !important; }

        .doc-shell versa-link span { color: #1e293b !important; }

        .doc-shell versa-link .doc-code { background-color: #134e4a !important; color: #99f6e4 !important; }

        .doc-shell .doc-route { border-color: #cbd5e1 !important; background-color: #ffffff !important; color: #1e293b
        !important; }

        .doc-shell .route-toggle { color: #1e293b !important; }

        .doc-shell .route-toggle > .route-method { color: #ffffff !important; }

        .doc-shell .route-method[data-method='GET'] { background-color: #047857 !important; } .doc-shell
        .route-method[data-method='POST'] { background-color: #0369a1 !important; } .doc-shell
        .route-method[data-method='PUT'] { background-color: #b45309 !important; } .doc-shell
        .route-method[data-method='PATCH'] { background-color: #6d28d9 !important; } .doc-shell
        .route-method[data-method='DELETE'] { background-color: #be123c !important; }

        .doc-shell .route-toggle code, .doc-shell .route-details code, .doc-shell .route-details label { color: #0f172a
        !important; }

        .doc-shell .route-toggle .route-chevron { color: #64748b !important; }

        .doc-shell .route-details { border-color: #cbd5e1 !important; background-color: #f8fafc !important; color:
        #334155 !important; }

        .doc-shell .route-details p, .doc-shell .route-details span { color: #475569 !important; }

        .doc-shell .doc-group { border-color: #0f766e !important; background: radial-gradient(ellipse at top left,
        rgb(20 184 166 / 18%), transparent 55%), #10252f !important; color: #f8fafc !important; }

        .doc-shell .doc-group h3, .doc-shell .doc-group code, .doc-shell .doc-group span { color: #f8fafc !important; }

        .doc-shell input:not([type='file']), .doc-shell select, .doc-shell textarea { border-color: #94a3b8 !important;
        background-color: #ffffff !important; color: #0f172a !important; }

        .doc-shell input::placeholder, .doc-shell textarea::placeholder { color: #64748b !important; opacity: 1; }

        .doc-shell .send-route-request { border: 0 !important; background-color: #0f766e !important; color: #ffffff
        !important; }

        .doc-shell .send-route-request:hover { background-color: #115e59 !important; }

        .doc-shell #filterRoutesButton { border: 0 !important; background-color: #0f172a !important; color: #ffffff
        !important; }

        .doc-shell .request-result { border-color: #cbd5e1 !important; background-color: #ffffff !important; color:
        #1e293b !important; }

        .doc-shell .request-result-status, .doc-shell .request-result-duration, .doc-shell .request-result-headers,
        .doc-shell .request-result-body { color: #334155 !important; }
    </style>
{% endblock %}
{% block appBody %}
    <div
        class="doc-shell min-h-full w-full bg-slate-100 px-4 py-6 text-slate-800 dark:bg-gray-950 dark:text-slate-100 sm:px-6 lg:px-10">
        {{ csrf_field('csrf_token')|raw }}
        <div class="mx-auto max-w-7xl">
            <header class="mb-8">
                <div class="flex flex-wrap items-center gap-3">
                    <div
                        class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-900 shadow-lg shadow-slate-900/15 dark:bg-teal-950">
                        <img class="h-6 w-6" src="/public/dashboard/img/favicon.webp" alt="VersaWYS Framework" />
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-teal-700 dark:text-teal-300">
                            VersaWYS · Herramientas de desarrollo
                        </p>
                        <h1
                            class="mt-0.5 text-2xl font-black tracking-tight text-slate-950 dark:text-white sm:text-3xl">
                            Explorador de rutas
                        </h1>
                    </div>
                    <span
                        class="rounded-full border border-slate-300 bg-white px-3 py-1 text-xs font-bold text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                        v{{ config['build']['version'] }}
                    </span>
                    <span
                        class="rounded-full border border-teal-700/20 bg-teal-50 px-3 py-1 text-xs font-bold text-teal-800 dark:border-teal-300/20 dark:bg-teal-950 dark:text-teal-200">
                        Documentación
                    </span>
                </div>
                <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
                    Explora endpoints, grupos, controladores y parámetros desde una sola vista.
                </p>
            </header>

            {% if (opcionActual|length) > 0 %}
                <nav aria-label="Ruta de navegación" class="mb-5 flex flex-wrap items-center gap-2 text-sm">
                    {% for opcion in opcionActual %}
                        {% if not loop.last %}
                            <versa-link
                                href="{{ opcion.link }}"
                                data-spa
                                class="font-semibold text-teal-800 transition hover:text-teal-600 dark:text-teal-300 dark:hover:text-teal-200">
                                {{ opcion.name }}
                            </versa-link>
                            <span aria-hidden="true" class="text-slate-400">/</span>
                        {% else %}
                            <span class="font-semibold text-slate-500 dark:text-slate-400">{{ opcion.name }}</span>
                        {% endif %}
                    {% endfor %}
                </nav>
            {% endif %}

            {% if (routesFiles|length) > 0 %}
                <section
                    aria-labelledby="route-files-title"
                    class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-7">
                    <div class="flex flex-wrap items-end justify-between gap-4">
                        <div>
                            <p class="text-xs font-bold uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">
                                Catálogo de rutas
                            </p>
                            <h2 id="route-files-title" class="mt-1 text-xl font-bold text-slate-950 dark:text-white">
                                Archivos de rutas
                            </h2>
                            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                                Selecciona un archivo para explorar sus endpoints.
                            </p>
                        </div>
                        <span
                            class="rounded-lg bg-slate-100 px-3 py-2 text-sm font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                            {{ routesFiles|length }} archivos
                        </span>
                    </div>
                    <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                        {% for file in ['all']|merge(routesFiles) %}
                            {% set summary = routesSummary[file] ?? { routes: 0, errors: 0, warnings: 0 } %}
                            <versa-link
                                href="?route={{ file|url_encode }}"
                                data-spa
                                class="group flex min-h-20 items-center justify-between gap-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 transition hover:-translate-y-0.5 hover:border-teal-500/60 hover:bg-white hover:shadow-md dark:border-slate-800 dark:bg-slate-950 dark:hover:border-teal-500/60 dark:hover:bg-slate-900">
                                <span class="flex min-w-0 items-center gap-3">
                                    <span
                                        class="doc-code flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-[10px] font-bold text-teal-300 dark:bg-teal-950">
                                        PHP
                                    </span>
                                    <span
                                        class="truncate text-sm font-bold text-slate-800 group-hover:text-teal-800 dark:text-slate-200 dark:group-hover:text-teal-300">
                                        {{ file == 'all' ? 'Todas las rutas' : file }}
                                        <span class="block text-xs font-medium text-slate-500 dark:text-slate-400">
                                            {{ summary.routes }} rutas
                                            {%- if summary.errors > 0 %}
                                                · <span class="font-bold text-rose-700 dark:text-rose-300">{{ summary.errors }} con error</span>
                                            {%- endif %}
                                            {%- if summary.warnings > 0 %}
                                                · <span class="text-amber-700 dark:text-amber-300">{{ summary.warnings }} sin documentar</span>
                                            {%- endif %}
                                        </span>
                                    </span>
                                </span>
                                <span
                                    aria-hidden="true"
                                    class="text-lg text-slate-400 transition group-hover:translate-x-1 group-hover:text-teal-600">
                                    →
                                </span>
                            </versa-link>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {% if (routesFromRouteFile|length) > 0 %}
                {% set lastOption = opcionActual|last %}
                <section
                    aria-labelledby="route-list-title"
                    class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <div
                        class="border-b border-slate-200 bg-white px-5 py-5 dark:border-slate-800 dark:bg-slate-900 sm:px-7">
                        <div class="flex flex-wrap items-start justify-between gap-4">
                            <div>
                                <p
                                    class="text-xs font-bold uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">
                                    Inventario de endpoints
                                </p>
                                <h2 id="route-list-title" class="mt-1 text-xl font-bold text-slate-950 dark:text-white">
                                    {{ lastOption.name|default('Rutas') }}
                                </h2>
                                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                                    Abre una ruta para consultar su implementación y parámetros.
                                </p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span
                                    class="rounded-lg bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                    {{ routesFromRouteFile|length }} rutas
                                </span>
                                <span
                                    class="rounded-lg bg-teal-50 px-3 py-2 text-xs font-bold text-teal-800 dark:bg-teal-950 dark:text-teal-200">
                                    Jerarquía de grupos
                                </span>
                            </div>
                        </div>
                        <div class="mt-5 grid gap-3 sm:grid-cols-[minmax(0,1fr)_180px_auto]">
                            <label class="relative block">
                                <span class="sr-only">Buscar rutas</span>
                                <span
                                    aria-hidden="true"
                                    class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                                    ⌕
                                </span>
                                <input
                                    type="search"
                                    id="searchInput"
                                    class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 pl-10 pr-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:focus:border-teal-400"
                                    placeholder="Buscar ruta, grupo o controlador…" />
                            </label>
                            <label>
                                <span class="sr-only">Filtrar por método HTTP</span>
                                <select
                                    id="methodFilter"
                                    class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-700 outline-none transition focus:border-teal-600 focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:focus:border-teal-400">
                                    <option value="">
                                        Todos los métodos
                                    </option>
                                    <option value="GET">
                                        GET
                                    </option>
                                    <option value="POST">
                                        POST
                                    </option>
                                    <option value="PUT">
                                        PUT
                                    </option>
                                    <option value="PATCH">
                                        PATCH
                                    </option>
                                    <option value="DELETE">
                                        DELETE
                                    </option>
                                </select>
                            </label>
                            <button
                                type="button"
                                id="filterRoutesButton"
                                class="rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-teal-800 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:ring-offset-2 dark:bg-teal-700 dark:hover:bg-teal-600">
                                Filtrar
                            </button>
                        </div>
                        <p
                            id="routeResultCount"
                            aria-live="polite"
                            class="mt-3 text-xs text-slate-500 dark:text-slate-400">
                            {{ routesFromRouteFile|length }} resultados
                        </p>
                    </div>

                    <div id="routesList" class="space-y-4 bg-slate-100/70 p-4 dark:bg-gray-950/70 sm:p-6">
                        {% for route in routesFromRouteFile %}
                            {% if route.showGroupHeading %}
                                <div
                                    class="doc-group doc-enter overflow-hidden rounded-xl border border-teal-800/70 px-4 py-4 shadow-md shadow-slate-900/10 dark:border-teal-900 sm:px-5"
                                    data-group-key="{{ route.groupKey|e('html_attr') }}">
                                    <div
                                        class="mb-3 flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.18em] text-teal-300">
                                        <span
                                            class="flex h-6 w-6 items-center justify-center rounded-md bg-teal-300/15">
                                            ⌘
                                        </span>
                                        Grupo de rutas
                                        <span class="h-px flex-1 bg-teal-200/20"></span>
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {% for group in route.groups %}
                                            <div
                                                class="flex min-w-0 items-center gap-2 rounded-lg border border-white/10 bg-black/15 px-3 py-2 {{
                                                not loop.first
                                                    ? 'ml-3 sm:ml-5'
                                                    : ''
                                                }}">
                                                <span
                                                    class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                                                    {{ loop.index == 1 ? 'Prefijo' : 'Anidado' }}
                                                </span>
                                                <code class="doc-code break-all text-xs font-bold text-white">
                                                    {{ group.path }}
                                                </code>
                                                {% if group.description %}
                                                    <span class="hidden text-xs text-slate-300 lg:inline">
                                                        {{ group.description }}
                                                    </span>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                            <article
                                class="doc-route route-item doc-enter overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900"
                                data-method="{{ route.method|upper }}"
                                data-route-template="{{ route.url|e('html_attr') }}"
                                data-group-key="{{ route.groupKey|e('html_attr') }}"
                                data-search="{{ (route.url ~ ' ' ~ route.route ~ ' ' ~ route.description ~ ' ' ~ route.class ~ ' '
                                    ~ route.class_method
                                    ~ ' '
                                    ~ route.groupKey)
                                    |lower
                                    |e('html_attr') }}">
                                <button
                                    type="button"
                                    class="route-toggle flex w-full items-center gap-3 px-4 py-4 text-left sm:gap-5 sm:px-5"
                                    aria-expanded="false">
                                    <span
                                        data-method="{{ route.method|upper }}"
                                        class="route-method inline-flex min-w-[72px] justify-center rounded-lg px-3 py-1.5 text-[11px] font-black tracking-wide text-white {{
                                        route.method == 'GET'
                                            ? 'bg-emerald-600'
                                            : route.method == 'POST'
                                                ? 'bg-sky-700'
                                                : route.method == 'PUT'
                                                    ? 'bg-amber-600'
                                                    : route.method == 'PATCH'
                                                        ? 'bg-violet-700'
                                                        : route.method == 'DELETE' ? 'bg-rose-700' : 'bg-slate-600'
                                        }}">
                                        {{ route.method|upper }}
                                    </span>
                                    <code
                                        class="doc-code min-w-0 flex-1 break-all text-xs font-semibold text-slate-800 dark:text-slate-200 sm:text-sm">
                                        {{ route.url }}
                                    </code>
                                    {% if route.csrf == 'protected' %}
                                        <span
                                            title="El Router valida el token CSRF en esta ruta"
                                            class="hidden rounded-md bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300 sm:inline">
                                            CSRF
                                        </span>
                                    {% elseif route.csrf == 'exempt' %}
                                        <span
                                            title="Ruta marcada con withoutCsrf(): no valida el token CSRF"
                                            class="rounded-md bg-rose-100 px-2 py-1 text-[10px] font-bold text-rose-800 dark:bg-rose-950 dark:text-rose-200">
                                            SIN CSRF
                                        </span>
                                    {% endif %}
                                    {% if (route.issues|length) > 0 %}
                                        <span
                                            class="rounded-md bg-amber-100 px-2 py-1 text-[10px] font-bold text-amber-900 dark:bg-amber-950 dark:text-amber-200">
                                            {{ route.issues|length }} {{ (route.issues|length) == 1 ? 'aviso' : 'avisos' }}
                                        </span>
                                    {% endif %}
                                    <span
                                        class="hidden flex-[1.2] text-sm leading-5 text-slate-600 dark:text-slate-400 md:block">
                                        {{ route.description|capitalize }}
                                    </span>
                                    <span aria-hidden="true" class="route-chevron text-slate-400 transition-transform">
                                        ⌄
                                    </span>
                                </button>
                                <p class="px-4 pb-3 text-sm leading-5 text-slate-600 dark:text-slate-400 md:hidden">
                                    {{ route.description|capitalize }}
                                </p>
                                {% if (route.issues|length) > 0 or route.url != route.route %}
                                    <ul class="space-y-1 px-4 pb-3 text-xs sm:px-5">
                                        {% if route.url != route.route %}
                                            <li class="text-slate-500 dark:text-slate-400">
                                                Declarada como <code class="doc-code">{{ route.route }}</code>; el
                                                panel se sirve bajo <code class="doc-code">/{{ config.admin.custom_url }}</code>.
                                            </li>
                                        {% endif %}
                                        {% for issue in route.issues %}
                                            <li
                                                class="{{ issue.level == 'error'
                                                    ? 'font-semibold text-rose-700 dark:text-rose-300'
                                                    : 'text-amber-800 dark:text-amber-300' }}">
                                                {{ issue.level == 'error' ? 'Error' : 'Aviso' }}: {{ issue.message }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                                <div
                                    class="route-details hidden border-t border-slate-200 bg-slate-50 px-4 py-5 dark:border-slate-800 dark:bg-slate-950 sm:px-5">
                                    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
                                        <div class="space-y-2">
                                            <div class="flex flex-wrap gap-x-2 text-sm">
                                                <span class="font-bold text-slate-500 dark:text-slate-400">
                                                    Controlador
                                                </span>
                                                <code class="doc-code text-slate-800 dark:text-slate-200">
                                                    {{ route.class }}
                                                </code>
                                            </div>
                                            <div class="flex flex-wrap gap-x-2 text-sm">
                                                <span class="font-bold text-slate-500 dark:text-slate-400">Acción</span>
                                                <code class="doc-code text-teal-800 dark:text-teal-300">
                                                    {{ route.class_method|trim }}
                                                </code>
                                            </div>
                                            {% if (route.middleware|length) > 0 %}
                                                <div class="pt-3">
                                                    <h3
                                                        class="mb-2 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                        Middleware
                                                    </h3>
                                                    <div class="flex flex-wrap gap-2">
                                                        {% for middleware in route.middleware %}
                                                            <span
                                                                class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-xs text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
                                                                <code class="doc-code">
                                                                    {{
                                                                        middleware.class|replace({
                                                                            '::class': ''
                                                                        })
                                                                    }}
                                                                </code><span class="text-slate-400">
                                                                    · {{ middleware.class_method }}
                                                                </span>
                                                            </span>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="grid gap-4 sm:grid-cols-2">
                                            {% if (route.pathParams|length) > 0 %}
                                                <div>
                                                    <h3
                                                        class="mb-2 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                        Parámetros de ruta
                                                    </h3>
                                                    {% for param in route.pathParams %}
                                                        <div
                                                            class="mb-2 rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-900">
                                                            <code
                                                                class="doc-code text-xs font-bold text-teal-800 dark:text-teal-300">
                                                                {{ param.name }}
                                                            </code><span class="ml-1 text-xs text-slate-400">
                                                                {{ param.type }}
                                                            </span>
                                                            <p
                                                                class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">
                                                                {{ param.description }}
                                                            </p>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                            {% if (route.queryParams|length) > 0 %}
                                                <div>
                                                    <h3
                                                        class="mb-2 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                        Parámetros de consulta
                                                    </h3>
                                                    {% for param in route.queryParams %}
                                                        <div
                                                            class="mb-2 rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-900">
                                                            <code
                                                                class="doc-code text-xs font-bold text-sky-800 dark:text-sky-300">
                                                                {{ param.name }}
                                                            </code><span class="ml-1 text-xs text-slate-400">
                                                                {{ param.type }}
                                                            </span>
                                                            <p
                                                                class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">
                                                                {{ param.description }}
                                                            </p>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                            {% if (route.requestBody|length) > 0 %}
                                                <div class="sm:col-span-2">
                                                    <h3
                                                        class="mb-2 text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                        Cuerpo de la solicitud
                                                    </h3>
                                                    <div class="grid gap-2 sm:grid-cols-2">
                                                        {% for param in route.requestBody %}
                                                            <div
                                                                class="rounded-lg border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-900">
                                                                <code
                                                                    class="doc-code text-xs font-bold text-amber-800 dark:text-amber-300">
                                                                    {{ param.name }}
                                                                </code><span class="ml-1 text-xs text-slate-400">
                                                                    {{ param.type }}
                                                                </span>
                                                                <p
                                                                    class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">
                                                                    {{ param.description }}
                                                                </p>
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="mt-6 border-t border-slate-200 pt-5 dark:border-slate-800">
                                        <div class="flex flex-wrap items-start justify-between gap-3">
                                            <div>
                                                <h3 class="text-sm font-black text-slate-900 dark:text-white">
                                                    Probar esta ruta
                                                </h3>
                                                <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">
                                                    La petición se enviará a este mismo sitio con tu sesión actual.
                                                </p>
                                            </div>
                                            <button
                                                type="button"
                                                class="send-route-request inline-flex items-center gap-2 rounded-lg bg-teal-700 px-4 py-2 text-xs font-bold text-white transition hover:bg-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 disabled:cursor-wait disabled:opacity-60 dark:bg-teal-600 dark:hover:bg-teal-500">
                                                <span aria-hidden="true">↗</span> Enviar petición
                                            </button>
                                        </div>
                                        {% if (route.routeParams|length) > 0 or (route.queryParams|length) > 0 %}
                                            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                                                {% if (route.routeParams|length) > 0 %}
                                                    <div class="space-y-3">
                                                        <h4
                                                            class="text-[11px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                            Parámetros de ruta
                                                        </h4>
                                                        {% for pathParam in route.routeParams %}
                                                            <label
                                                                class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                                                {{ pathParam }}
                                                                <input
                                                                    type="text"
                                                                    data-path-param="{{ pathParam|e('html_attr') }}"
                                                                    class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-normal text-slate-900 outline-none focus:border-teal-600 focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                                                                    placeholder="Valor para {{ pathParam|e(
                                                                        'html_attr'
                                                                    ) }}"
                                                                    required />
                                                            </label>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                                {% if (route.queryParams|length) > 0 %}
                                                    <div class="space-y-3">
                                                        <h4
                                                            class="text-[11px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                                            Parámetros de consulta
                                                        </h4>
                                                        {% for param in route.queryParams %}
                                                            <label
                                                                class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                                                {{ param.name }}
                                                                <input
                                                                    type="text"
                                                                    data-query-param="{{ param.name|e('html_attr') }}"
                                                                    class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-normal text-slate-900 outline-none focus:border-teal-600 focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                                                                    placeholder="{{ param.description|e(
                                                                        'html_attr'
                                                                    ) }}" />
                                                            </label>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                        {% if route.method in ['POST', 'PUT', 'PATCH', 'DELETE'] %}
                                            <div class="mt-4">
                                                <label
                                                    class="block text-xs font-semibold text-slate-700 dark:text-slate-300"
                                                    for="requestBody-{{ loop.index }}">
                                                    Cuerpo JSON <span class="font-normal text-slate-500">(opcional)</span>
                                                </label>
                                                <textarea
                                                    id="requestBody-{{ loop.index }}"
                                                    class="request-body doc-code mt-1.5 min-h-28 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs leading-5 text-slate-900 outline-none focus:border-teal-600 focus:ring-2 focus:ring-teal-600/20 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
                                                    placeholder='{"campo": "valor"}'
                                                    spellcheck="false"></textarea>
                                                {% for param in route.requestBody %}
                                                    {% if 'file' in param.type %}
                                                        <label
                                                            class="mt-3 block text-xs font-semibold text-slate-700 dark:text-slate-300">
                                                            {{ param.name }}
                                                            <span class="font-normal text-slate-500">
                                                                · {{ param.description }}
                                                            </span>
                                                            <input
                                                                type="file"
                                                                data-file-param="{{ param.name|e('html_attr') }}"
                                                                {{ param.type == 'file[]' ? 'multiple' : '' }}
                                                                class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white text-xs text-slate-700 file:mr-3 file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-xs file:font-bold file:text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:file:bg-slate-800 dark:file:text-slate-200" />
                                                        </label>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                        <div
                                            class="request-result mt-4 hidden overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900"
                                            role="status"
                                            aria-live="polite">
                                            <div
                                                class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-3 py-2.5 dark:border-slate-700">
                                                <p
                                                    class="request-result-status text-xs font-black text-slate-800 dark:text-slate-100"></p>
                                                <p
                                                    class="request-result-duration text-xs text-slate-500 dark:text-slate-400"></p>
                                            </div>
                                            <details
                                                class="border-b border-slate-200 px-3 py-2 text-xs dark:border-slate-700">
                                                <summary
                                                    class="cursor-pointer font-bold text-slate-600 dark:text-slate-300">
                                                    Encabezados de respuesta
                                                </summary>
                                                <pre
                                                    class="request-result-headers doc-code mt-2 max-h-36 overflow-auto whitespace-pre-wrap break-all text-[11px] text-slate-600 dark:text-slate-400"></pre>
                                            </details>
                                            <pre
                                                class="request-result-body doc-code max-h-96 overflow-auto whitespace-pre-wrap break-words p-3 text-xs leading-5 text-slate-700 dark:text-slate-300"></pre>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                        <p
                            id="emptyRoutesMessage"
                            class="hidden rounded-xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-sm text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                            No hay rutas que coincidan con estos filtros.
                        </p>
                    </div>
                </section>
            {% endif %}
        </div>
    </div>
{% endblock %}
{% block appScript %}
    <!-- prettier-ignore -->
    <script>
        (() => { const routesList = document.getElementById('routesList'); const searchInput =
        document.getElementById('searchInput'); const methodFilter = document.getElementById('methodFilter'); const
        filterButton = document.getElementById('filterRoutesButton'); const resultCount =
        document.getElementById('routeResultCount'); const emptyMessage = document.getElementById('emptyRoutesMessage');
        const maxResponseBytes = 1024 * 1024;

        async function readResponseBody(response) { const contentType = response.headers.get('content-type') || ''; if
        (!/json|text|xml|javascript|x-www-form-urlencoded/i.test(contentType)) {
        return '[No se muestra el cuerpo binario (' + (contentType || 'tipo desconocido') + ').]'; }
        if (!response.body) return '';

        const reader = response.body.getReader(); const decoder = new TextDecoder(); let body = ''; let byteCount = 0;
        while (true) { const { done, value } = await reader.read(); if (done) break; byteCount += value.byteLength; if
        (byteCount > maxResponseBytes) { body += decoder.decode(value.subarray(0, Math.max(0, value.byteLength -
        (byteCount - maxResponseBytes))), { stream: true }); await reader.cancel();
        return body + '\n\n[Respuesta truncada después de 1 MB.]'; } body += decoder.decode(value, { stream: true }); }
        return body +
        decoder.decode(); }

        async function sendRouteRequest(button) { const routeCard = button.closest('.route-item'); const result =
        routeCard?.querySelector('.request-result'); if (!routeCard || !result) return;

        const method = routeCard.dataset.method || 'GET'; const template = routeCard.dataset.routeTemplate || ''; let
        path = template; for (const input of routeCard.querySelectorAll('[data-path-param]')) { const name =
        input.dataset.pathParam || ''; const value = input.value.trim(); if (!value) { input.focus();
        input.reportValidity(); return; } path = path.replace(`{${name}}`, encodeURIComponent(value)); } if
        (/\{[^}]+\}/.test(path)) { result.classList.remove('hidden');
        result.querySelector('.request-result-status').textContent = 'Faltan parámetros de ruta';
        result.querySelector('.request-result-body').textContent = 'Completa los parámetros obligatorios '
        + 'para construir la URL.'; return; }

        const url = new URL(path, window.location.origin); if (url.origin !== window.location.origin) {
        result.classList.remove('hidden'); result.querySelector('.request-result-status').textContent = 'Destino inválido';
        result.querySelector('.request-result-body').textContent = 'El probador solo envía peticiones '
        + 'al mismo origen.'; return; }

        for (const input of routeCard.querySelectorAll('[data-query-param]')) { const value = input.value.trim(); if
        (value) url.searchParams.set(input.dataset.queryParam || '', value); }

        const mutating = !['GET', 'HEAD', 'OPTIONS'].includes(method); const headers = new Headers({ Accept:
        'application/json, text/plain, */*', 'X-Requested-With': 'XMLHttpRequest', }); const csrfToken =
        document.querySelector('#csrf_token')?.value; if (csrfToken) headers.set('X-CSRF-Token', csrfToken);

        const request = { method, credentials: 'same-origin', redirect: 'error', headers }; if (!['GET', 'HEAD'].includes(method)) { const
        bodyInput = routeCard.querySelector('.request-body'); const rawBody = bodyInput?.value.trim() || ''; let
        bodyData = {}; if (rawBody) { try { bodyData = JSON.parse(rawBody); if (!bodyData || typeof bodyData !==
        'object' || Array.isArray(bodyData)) { throw new Error('El cuerpo JSON debe ser un objeto.'); } } catch (error)
        { result.classList.remove('hidden'); result.querySelector('.request-result-status').textContent = 'JSON inválido';
        result.querySelector('.request-result-body').textContent = error instanceof Error ? error.message :
        'Revisa el formato e inténtalo de nuevo.'; bodyInput?.focus(); return; } }

        const fileInputs = [...routeCard.querySelectorAll('[data-file-param]')]; const selectedFiles =
        fileInputs.some(input => input.files?.length > 0); if (selectedFiles) { const formData = new FormData();
        for (const [key, value] of Object.entries(bodyData)) { formData.append(key, typeof value === 'object' && value !==
        null ? JSON.stringify(value) : String(value)); }
        for (const input of fileInputs) { for (const file of input.files) {
        formData.append(input.dataset.fileParam || '', file); } } request.body = formData; } else if (rawBody) {
        headers.set('Content-Type', 'application/json'); request.body = JSON.stringify(bodyData); } }

        if (
        mutating && !window.confirm('Vas a enviar ' + method + ' ' + url.pathname + url.search
        + '. Puede modificar datos reales y no se puede deshacer automáticamente. ¿Continuar?')
        ) return;

        const status = result.querySelector('.request-result-status'); const duration =
        result.querySelector('.request-result-duration'); const headersOutput =
        result.querySelector('.request-result-headers'); const bodyOutput =
        result.querySelector('.request-result-body'); const originalLabel = button.textContent.trim(); const start =
        performance.now(); button.disabled = true; button.textContent = 'Enviando…'; result.classList.remove('hidden');
        status.textContent = `${method} ${url.pathname}${url.search}`; duration.textContent = 'En curso…';
        headersOutput.textContent = ''; bodyOutput.textContent = '';

        try { const response = await fetch(url, request); const body = await readResponseBody(response); const elapsed =
        Math.round(performance.now() - start); status.textContent = `${response.status} ${response.statusText ||
        ''}`.trim(); status.className = 'request-result-status text-xs font-black '
        + (response.ok ? 'text-emerald-700 dark:text-emerald-300' : 'text-rose-700 dark:text-rose-300');
        duration.textContent = `${elapsed} ms`;
        headersOutput.textContent = [...response.headers.entries()].map(([key, value]) => `${key}: ${value}`).join('\n')
        || 'Sin encabezados visibles.'; bodyOutput.textContent = body || '(Respuesta sin contenido)'; } catch (error) {
        status.textContent = 'Error de red';
        status.className = 'request-result-status text-xs font-black text-rose-700 dark:text-rose-300';
        duration.textContent = `${Math.round(performance.now() - start)} ms`;
        bodyOutput.textContent = error instanceof Error ? error.message : 'No se pudo completar la petición.'; } finally
        { button.disabled = false; button.textContent = originalLabel; } }

        function updateRoutes() { if (!routesList || !searchInput || !methodFilter) return;

        const term = searchInput.value.trim().toLocaleLowerCase(); const selectedMethod = methodFilter.value; let
        visibleCount = 0;

        routesList.querySelectorAll('.route-item').forEach(item => { const matchesText = (item.dataset.search ||
        '').includes(term); const matchesMethod = !selectedMethod || item.dataset.method === selectedMethod; const
        visible = matchesText && matchesMethod; item.classList.toggle('hidden', !visible); if (visible) visibleCount++;
        });

        routesList.querySelectorAll('.doc-group').forEach(group => { let sibling = group.nextElementSibling; let
        hasVisibleRoute = false; while (sibling && !sibling.classList.contains('doc-group')) { if (
        sibling.classList.contains('route-item') && !sibling.classList.contains('hidden') &&
        sibling.getAttribute('data-group-key') === group.getAttribute('data-group-key') ) { hasVisibleRoute = true;
        break; } sibling = sibling.nextElementSibling; } group.classList.toggle('hidden', !hasVisibleRoute); });

        if (resultCount) resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'resultado' : 'resultados'}`;
        emptyMessage?.classList.toggle('hidden', visibleCount > 0); }

        routesList?.addEventListener('click', event => { if (!(event.target instanceof Element)) return; const
        sendButton = event.target.closest('.send-route-request'); if (sendButton instanceof HTMLButtonElement) {
        event.preventDefault(); event.stopPropagation(); void sendRouteRequest(sendButton); return; } const toggle =
        event.target.closest('.route-toggle'); if (!(toggle instanceof HTMLButtonElement)) return; const details =
        toggle.parentElement?.querySelector('.route-details'); if (!details) return; const expanded =
        toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!expanded));
        details.classList.toggle('hidden', expanded);
        toggle.querySelector('.route-chevron')?.classList.toggle('rotate-180', !expanded); });

        searchInput?.addEventListener('input', updateRoutes); methodFilter?.addEventListener('change', updateRoutes);
        filterButton?.addEventListener('click', updateRoutes); updateRoutes(); })();
    </script>
{% endblock %}
