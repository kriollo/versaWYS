# Plantilla: reemplazar example.com, /var/www/mi-proyecto y la versión de PHP-FPM antes de usar.
# Apache2 VirtualHost equivalente a nginx-config-optimized.conf
# Dominio: example.com
# Requiere modulos: ssl rewrite headers expires deflate proxy proxy_fcgi http2 setenvif

# Estas directivas son de contexto global (server config), no dentro de VirtualHost
ServerTokens Prod
ServerSignature Off
TraceEnable Off

<VirtualHost *:80>
    ServerName example.com

    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName example.com
    ServerAdmin admin@example.com

    DocumentRoot /var/www/mi-proyecto/current
    DirectoryIndex index.php index.html

    Protocols h2 http/1.1

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/example.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    # Body size maximo: 200 MB
    LimitRequestBody 209715200

    # Metodos HTTP permitidos
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} !^(GET|POST|PUT|DELETE|OPTIONS|HEAD|PATCH)$ [NC]
    RewriteRule ^ - [R=405,L]

    # Bloquear acceso a archivos sensibles (404 para no revelar existencia)
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|vhost\.conf|\.env)$ - [R=404,L,NC]
    RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
    RewriteRule .+~$ - [R=404,L]

    # Bloquear directorios sensibles
    RewriteRule ^vendor(/|$) - [R=404,L,NC]
    # De node_modules solo se sirven los módulos JS y CSS que importa el frontend (Vue, SweetAlert2...)
    RewriteCond %{REQUEST_URI} !\.(js|mjs|css)$ [NC]
    RewriteRule ^node_modules(/|$) - [R=404,L,NC]

    # Forzar router para carpetas sensibles
    RewriteRule ^(app|versaWYS|vendor|logs|src|configs|documentacion)(/|$) /index.php [QSA,L]

    # Headers de seguridad
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), payment=(self), usb=(), interest-cohort=()"
    Header always unset X-Powered-By

    # Evitar indexacion de store
    <Location "/dashboard/store/">
        Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    </Location>

    <Directory /var/www/mi-proyecto/current>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted

        RewriteEngine On
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteRule ^ index.php [QSA,L]
    </Directory>

    # PHP-FPM
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.4-fpm.sock|fcgi://localhost/"
    </FilesMatch>

    ProxyTimeout 300

    # Compresion gzip/deflate
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml application/atom+xml image/svg+xml
    </IfModule>

    # Politicas de cache para estaticos
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType image/gif "access plus 1 year"
        ExpiresByType image/webp "access plus 1 year"
        ExpiresByType image/avif "access plus 1 year"
        ExpiresByType image/x-icon "access plus 1 year"
        ExpiresByType font/woff "access plus 1 year"
        ExpiresByType font/woff2 "access plus 1 year"
        ExpiresByType application/font-woff "access plus 1 year"
        ExpiresByType text/css "access plus 1 year"
        ExpiresByType application/javascript "access plus 1 year"
        ExpiresByType application/pdf "access plus 1 year"
        ExpiresByType image/svg+xml "access plus 1 year"
        ExpiresByType video/mp4 "access plus 30 days"
        ExpiresByType video/webm "access plus 30 days"
        ExpiresByType audio/mpeg "access plus 30 days"
        ExpiresByType audio/wav "access plus 30 days"
    </IfModule>

    <FilesMatch "\.(jpg|jpeg|png|gif|ico|webp|avif|bmp|tiff)$">
        Header always set Cache-Control "public, immutable, no-transform"
    </FilesMatch>

    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header always set Cache-Control "public, immutable"
        Header always set Access-Control-Allow-Origin "*"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header always set Cache-Control "public, immutable, no-transform"
    </FilesMatch>

    <FilesMatch "\.(pdf|svg)$">
        Header always set Cache-Control "public, no-transform"
    </FilesMatch>

    <FilesMatch "\.(mp4|webm|ogg|avi|mov|flv|wmv|mp3|wav|m4a|aac|flac)$">
        Header always set Cache-Control "public, no-transform"
    </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/example.com-error.log
    CustomLog ${APACHE_LOG_DIR}/example.com-access.log combined
</VirtualHost>
